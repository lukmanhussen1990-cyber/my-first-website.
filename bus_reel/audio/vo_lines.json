 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You pooped on the college bus.",
   "start": 0.0,
   "end": 2.56
  },
  {
   "i": 2,
   "who": "N",
   "text": "But you thought it was a fart.",
   "start": 3.26,
   "end": 4.58
  },
  {
   "i": 3,
   "who": "N",
   "text": "The bus is full.",
   "start": 5.54,
   "end": 6.6
  },
  {
   "i": 4,
   "who": "N",
   "text": "Then your crush gets on.",
   "start": 7.3,
   "end": 8.58
  },
  {
   "i": 5,
   "who": "N",
   "text": "The only empty seat... is next to you.",
   "start": 9.12,
   "end": 11.74
  },
  {
   "i": 6,
   "who": "N",
   "text": "She sits down.",
   "start": 12.32,
   "end": 13.12
  },
  {
   "i": 7,
   "who": "N",
   "text": "She smiles at you.",
   "start": 13.66,
   "end": 14.68
  },
  {
   "i": 8,
   "who": "N",
   "text": "You smile back.",
   "start": 15.04,
   "end": 15.96
  },
  {
   "i": 9,
   "who": "N",
   "text": "Then... the smell reaches her.",
   "start": 16.88,
   "end": 18.7
  },
  {
   "i": 10,
   "who": "N",
   "text": "Her smile stops.",
   "start": 19.2,
   "end": 20.2
  },
  {
   "i": 11,
   "who": "N",
   "text": "She opens the window.",
   "start": 20.88,
   "end": 21.8
  },
  {
   "i": 12,
   "who": "N",
   "text": "Then she puts her whole head outside.",
   "start": 22.42,
   "end": 24.52
  },
  {
   "i": 13,
   "who": "N",
   "text": "The driver looks in the mirror",
   "start": 25.04,
   "end": 26.36
  },
  {
   "i": 14,
   "who": "N",
   "text": "and stops the bus.",
   "start": 26.36,
   "end": 27.82
  },
  {
   "i": 15,
   "who": "N",
   "text": "Everyone gets off.",
   "start": 28.42,
   "end": 29.34
  },
  {
   "i": 16,
   "who": "N",
   "text": "Except you.",
   "start": 29.34,
   "end": 30.42
  },
  {
   "i": 17,
   "who": "N",
   "text": "Have a nice ride!",
   "start": 31.0,
   "end": 31.72
  }
 ]
