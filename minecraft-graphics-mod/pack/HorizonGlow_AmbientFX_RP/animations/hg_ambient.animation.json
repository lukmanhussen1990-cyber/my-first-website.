          "pre_effect_script": "variable.hg_n = (query.distance_from_camera < 8 && query.position(1) > 56 && !query.is_in_water && query.time_of_day > 0.26 && query.time_of_day < 0.74) ? 3 : 0;"
        },
        "0.25": {
          "effect": "hg_plankton",
          "pre_effect_script": "variable.hg_n = (query.distance_from_camera < 8 && query.is_in_water) ? 3 : 0;"
