tellraw @s {"rawtext":[{"text":"§8=== §aSECRET UNDERGROUND BUNKER §8==="}]}
tellraw @s {"rawtext":[{"text":"§f/function bunker/build §7- build it where you stand"}]}
tellraw @s {"rawtext":[{"text":"§f/function bunker/supplies §7- starter kit (beds, torches, food, tools)"}]}
tellraw @s {"rawtext":[{"text":"§f/function bunker/remove §7- fill it back in"}]}
tellraw @s {"rawtext":[{"text":"§8--- §aENTRANCE §8---"}]}
tellraw @s {"rawtext":[{"text":"§7Mossy §fboulder §7just south of you. Climb on TOP, the hole is in the top face. Ladder goes 20 blocks down."}]}
tellraw @s {"rawtext":[{"text":"§7There are decoy rocks around it so it does not stand out."}]}
tellraw @s {"rawtext":[{"text":"§8--- §aROOMS §8---"}]}
tellraw @s {"rawtext":[{"text":"§7Airlock, main hall, wheat farm, workshop/armoury, living quarters, command room."}]}
tellraw @s {"rawtext":[{"text":"§8--- §cSECRET 1: THE VAULT §8---"}]}
tellraw @s {"rawtext":[{"text":"§7In the living quarters, the §fbookshelf wall §7hides a vault. Break the §fmiddle three §7shelves. Place them back to seal yourself in."}]}
tellraw @s {"rawtext":[{"text":"§8--- §cSECRET 2: ESCAPE TUNNEL §8---"}]}
tellraw @s {"rawtext":[{"text":"§7East wall of the command room. 16 block tunnel, then a ladder up into a §fsecond boulder §7about 30 blocks away."}]}
