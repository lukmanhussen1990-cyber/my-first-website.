{
 "takes": {
  "N": "PLACEHOLDER"
 },
 "duration": 45.454,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "What if your balls doubled in size every minute?",
   "start": 0.15,
   "end": 2.994
  },
  {
   "i": 2,
   "who": "N",
   "text": "Right now, the pair weighs about forty grams.",
   "start": 3.254,
   "end": 5.97
  },
  {
   "i": 3,
   "who": "N",
   "text": "Five minutes in: they're the size of melons.",
   "start": 6.23,
   "end": 8.91
  },
  {
   "i": 4,
   "who": "N",
   "text": "Ten minutes: forty kilos. Like a bag of cement.",
   "start": 9.17,
   "end": 12.186
  },
  {
   "i": 5,
   "who": "N",
   "text": "You try to stand up. You can't.",
   "start": 12.446,
   "end": 14.534
  },
  {
   "i": 6,
   "who": "N",
   "text": "Fifteen minutes: as heavy as a small car.",
   "start": 14.794,
   "end": 17.366
  },
  {
   "i": 7,
   "who": "N",
   "text": "Twenty minutes: the army arrives.",
   "start": 17.626,
   "end": 19.538
  },
  {
   "i": 8,
   "who": "N",
   "text": "They try to move them.",
   "start": 19.798,
   "end": 21.21
  },
  {
   "i": 9,
   "who": "N",
   "text": "Damage: zero percent.",
   "start": 21.47,
   "end": 22.702
  },
  {
   "i": 10,
   "who": "N",
   "text": "Thirty minutes: taller than an eleven-story building.",
   "start": 22.962,
   "end": 25.842
  },
  {
   "i": 11,
   "who": "N",
   "text": "The world panics.",
   "start": 26.102,
   "end": 27.086
  },
  {
   "i": 12,
   "who": "N",
   "text": "Your mom is stuck in traffic because of you.",
   "start": 27.346,
   "end": 30.046
  },
  {
   "i": 13,
   "who": "N",
   "text": "One hour: heavier than every mountain on Earth.",
   "start": 30.306,
   "end": 33.094
  },
  {
   "i": 14,
   "who": "N",
   "text": "Eighty-seven minutes: heavier than the Earth itself.",
   "start": 33.354,
   "end": 36.198
  },
  {
   "i": 15,
   "who": "N",
   "text": "Now the Earth orbits YOU.",
   "start": 36.458,
   "end": 37.978
  },
  {
   "i": 16,
   "who": "N",
   "text": "Two hours: gravity wins.",
   "start": 38.238,
   "end": 39.702
  },
  {
   "i": 17,
   "who": "N",
   "text": "You become a black hole.",
   "start": 39.962,
   "end": 41.446
  },
  {
   "i": 18,
   "who": "N",
   "text": "Which is why\u2026",
   "start": 41.706,
   "end": 42.546
  },
  {
   "i": 19,
   "who": "N",
   "text": "\u2026you should never ask 'what if'.",
   "start": 42.806,
   "end": 44.594
  }
 ]
}