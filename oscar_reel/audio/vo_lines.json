 "source": "user upload",
 "duration": 57.69,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You just won the Oscar.",
   "start": 0.285,
   "end": 1.96
  },
  {
   "i": 2,
   "who": "N",
   "text": "You walk up to the mic.",
   "start": 2.395,
   "end": 4.185
  },
  {
   "i": 3,
   "who": "N",
   "text": "And you just pooped your pants.",
   "start": 4.505,
   "end": 7.785
  },
  {
   "i": 4,
   "who": "N",
   "text": "A billion people are watching.",
   "start": 8.19,
   "end": 10.075
  },
  {
   "i": 5,
   "who": "N",
   "text": "You say: \"Thank you.\"",
   "start": 10.49,
   "end": 11.985
  },
  {
   "i": 6,
   "who": "N",
   "text": "Your voice cracks.",
   "start": 12.405,
   "end": 13.335
  },
  {
   "i": 7,
   "who": "N",
   "text": "The front row sniffs.",
   "start": 13.725,
   "end": 15.08
  },
  {
   "i": 8,
   "who": "N",
   "text": "You get nervous.",
   "start": 15.47,
   "end": 16.29
  },
  {
   "i": 9,
   "who": "N",
   "text": "So you poop again.",
   "start": 16.66,
   "end": 18.095
  },
  {
   "i": 10,
   "who": "YOU",
   "text": "\"I want to thank my mom...\"",
   "start": 18.475,
   "end": 19.845
  },
  {
   "i": 11,
   "who": "N",
   "text": "And again.",
   "start": 20.165,
   "end": 21.065
  },
  {
   "i": 12,
   "who": "N",
   "text": "Your co-star holds her nose.",
   "start": 21.445,
   "end": 23.01
  },
  {
   "i": 13,
   "who": "N",
   "text": "The camera zooms in on your face.",
   "start": 23.43,
   "end": 25.48
  },
  {
   "i": 14,
   "who": "N",
   "text": "You poop a little more.",
   "start": 25.88,
   "end": 27.035
  },
  {
   "i": 15,
   "who": "N",
   "text": "Out of nerves.",
   "start": 27.355,
   "end": 28.165
  },
  {
   "i": 16,
   "who": "N",
   "text": "The director in row one",
   "start": 28.615,
   "end": 30.01
  },
  {
   "i": 17,
   "who": "N",
   "text": "is quietly crying.",
   "start": 30.01,
   "end": 31.375
  },
  {
   "i": 18,
   "who": "N",
   "text": "Not from joy.",
   "start": 31.79,
   "end": 32.635
  },
  {
   "i": 19,
   "who": "N",
   "text": "What you don't know:",
   "start": 33.635,
   "end": 34.64
  },
  {
   "i": 20,
   "who": "N",
   "text": "Oscar winners only get about forty-five seconds",
   "start": 35.045,
   "end": 37.475
  },
  {
   "i": 21,
   "who": "N",
   "text": "for their speech.",
   "start": 37.475,
   "end": 38.53
  },
  {
   "i": 22,
   "who": "N",
   "text": "Then the orchestra starts playing",
   "start": 38.855,
   "end": 40.2
  },
  {
   "i": 23,
   "who": "N",
   "text": "to push you off the stage.",
   "start": 40.2,
   "end": 42.065
  },
  {
   "i": 24,
   "who": "N",
   "text": "Forty seconds.",
   "start": 42.665,
   "end": 43.505
  },
  {
   "i": 25,
   "who": "N",
   "text": "Forty-four.",
   "start": 44.105,
   "end": 44.785
  },
  {
   "i": 26,
   "who": "N",
   "text": "Forty-five.",
   "start": 45.435,
   "end": 46.22
  },
  {
   "i": 27,
   "who": "N",
   "text": "The music starts.",
   "start": 46.72,
   "end": 47.67
  },
  {
   "i": 28,
   "who": "N",
   "text": "You walk off.",
   "start": 48.015,
   "end": 48.78
  },
  {
   "i": 29,
   "who": "N",
   "text": "Very... slowly.",
   "start": 49.1,
   "end": 50.595
  },
  {
   "i": 30,
   "who": "N",
   "text": "The orchestra keeps playing.",
   "start": 51.035,
   "end": 52.485
  },
  {
   "i": 31,
   "who": "N",
   "text": "With one hand.",
   "start": 52.84,
   "end": 53.685
  },
  {
   "i": 32,
   "who": "N",
   "text": "The other is holding their nose.",
   "start": 54.485,
   "end": 56.3
  }
 ]
