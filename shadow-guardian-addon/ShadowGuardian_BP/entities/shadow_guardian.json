{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "sg:shadow_guardian",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {

      "sg:wild": {
        "minecraft:type_family": { "family": ["shadow_guardian", "mob"] },
        "minecraft:movement": { "value": 0.15, "max": 0.15 },
        "minecraft:flying_speed": { "value": 0.15 },
        "minecraft:physics": { "has_gravity": false, "push_towards_closest_space": true },
        "minecraft:tameable": {
          "probability": 1.0,
          "tame_items": ["nether_star", "diamond"],
          "tame_event": { "event": "sg:on_tame", "target": "self" }
        },
        "minecraft:behavior.random_hover": {
          "priority": 6,
          "xz_dist": 10,
          "y_dist": 3,
          "y_offset": 0,
          "interval": 60,
          "hover_height": [1, 3]
        }
      },

      "sg:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "villager" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "wandering_trader" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "shadow_guardian" },
                  { "test": "has_component", "subject": "other", "operator": "!=", "value": "minecraft:is_tamed" }
                ]
              },
              "max_dist": 48
            }
          ]
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "attack_owner": false,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "monster" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "enderman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "zombie_pigman" },
                  {
                    "any_of": [
                      { "test": "is_family", "subject": "other", "operator": "!=", "value": "piglin" },
                      { "test": "is_family", "subject": "other", "value": "piglin_brute" }
                    ]
                  }
                ]
              },
              "max_dist": 24
            },
            {
              "filters": { "test": "is_family", "subject": "other", "value": "dragon" },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3,
          "track_target": true,
          "speed_multiplier": 2.5,
          "cooldown_time": 0.6,
          "horizontal_reach": 1.2
        }
      },

      "sg:mode_follow": {
        "minecraft:type_family": { "family": ["shadow_guardian", "mob"] },
        "minecraft:movement": { "value": 0.4, "max": 0.4 },
        "minecraft:flying_speed": { "value": 0.4 },
        "minecraft:physics": { "has_gravity": false, "push_towards_closest_space": true },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 2.5,
          "start_distance": 5,
          "stop_distance": 3,
          "can_teleport": true
        },
        "minecraft:behavior.random_hover": {
          "priority": 7,
          "xz_dist": 3,
          "y_dist": 2,
          "y_offset": 0,
          "interval": 80,
          "hover_height": [1, 2]
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_owner", "subject": "other", "value": true },
                    {
                      "any_of": [
                        { "test": "is_sneaking", "subject": "other", "value": true },
                        { "test": "is_sneak_held", "subject": "other", "value": true }
                      ]
                    }
                  ]
                },
                "event": "sg:stay",
                "target": "self"
              },
              "swing": true,
              "interact_text": "action.interact.sg_stay"
            },
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_owner", "subject": "other", "value": true },
                    { "test": "is_sneaking", "subject": "other", "value": false },
                    { "test": "is_sneak_held", "subject": "other", "value": false }
                  ]
                },
                "event": "sg:hint",
                "target": "self"
              },
              "interact_text": "action.interact.sg_hint"
            }
          ]
        }
      },

      "sg:mode_stay": {
        "minecraft:type_family": { "family": ["shadow_guardian", "mob", "sg_staying"] },
        "minecraft:movement": { "value": 0.0, "max": 0.0 },
        "minecraft:flying_speed": { "value": 0.0 },
        "minecraft:physics": { "has_gravity": true, "push_towards_closest_space": true },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_owner", "subject": "other", "value": true }
                  ]
                },
                "event": "sg:follow",
                "target": "self"
              },
              "swing": true,
              "interact_text": "action.interact.sg_follow"
            }
          ]
        }
      }
    },

    "components": {
      "minecraft:collision_box": { "width": 1.0, "height": 2.6 },
      "minecraft:health": { "value": 1000, "max": 1000 },
      "minecraft:attack": { "damage": 30 },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:can_fly": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:jump.static": {},
      "minecraft:movement.hover": {},
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": true,
        "can_path_from_air": true,
        "avoid_water": false,
        "avoid_damage_blocks": false,
        "avoid_sun": false
      },
      "minecraft:fire_immune": {},
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": false },
          { "cause": "fire", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false },
          { "cause": "lava", "deals_damage": false },
          { "cause": "block_explosion", "deals_damage": false },
          { "cause": "entity_explosion", "deals_damage": false },
          { "cause": "lightning", "deals_damage": false },
          { "cause": "suffocation", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false }
        ]
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["sg:wild"] }
      },
      "sg:on_tame": {
        "sequence": [
          { "remove": { "component_groups": ["sg:wild"] } },
          { "add": { "component_groups": ["sg:tamed", "sg:mode_follow"] } }
        ]
      },
      "sg:stay": {
        "sequence": [
          { "remove": { "component_groups": ["sg:mode_follow"] } },
          { "add": { "component_groups": ["sg:mode_stay"] } }
        ]
      },
      "sg:follow": {
        "sequence": [
          { "remove": { "component_groups": ["sg:mode_stay"] } },
          { "add": { "component_groups": ["sg:mode_follow"] } }
        ]
      },
      "sg:hint": {}
    }
  }
}
