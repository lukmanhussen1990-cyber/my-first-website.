{
  "format_version": "1.8.0",
  "animations": {

    "animation.shadow_guardian.float": {
      "loop": true,
      "bones": {
        "root": {
          "position": [0, "math.sin(query.life_time * 100) * 0.8", 0]
        },
        "head": {
          "rotation": ["math.sin(query.life_time * 80) * 2", "math.sin(query.life_time * 40) * 4", 0]
        },
        "halo": {
          "rotation": [0, "query.life_time * 90", 0]
        },
        "arm_l": {
          "rotation": ["math.sin(query.life_time * 90) * 4", 0, "-6 + math.sin(query.life_time * 70) * 3"]
        },
        "arm_r": {
          "rotation": ["-math.sin(query.life_time * 90) * 4", 0, "6 - math.sin(query.life_time * 70) * 3"]
        },
        "tail1": {
          "rotation": ["math.sin(query.life_time * 70) * 4", 0, "math.sin(query.life_time * 50) * 3"]
        },
        "tail2": {
          "rotation": ["math.sin(query.life_time * 70 - 40) * 7", 0, "math.sin(query.life_time * 50 - 30) * 5"]
        },
        "tail3": {
          "rotation": ["math.sin(query.life_time * 70 - 80) * 10", 0, "math.sin(query.life_time * 50 - 60) * 8"]
        }
      }
    },

    "animation.shadow_guardian.wings": {
      "loop": true,
      "bones": {
        "wing_l": {
          "rotation": [0, 0, "math.sin(query.life_time * 200) * 12"]
        },
        "wing_r": {
          "rotation": [0, 0, "-math.sin(query.life_time * 200) * 12"]
        }
      }
    },

    "animation.shadow_guardian.move": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["math.clamp(query.ground_speed, 0, 8) * 2.5", 0, 0]
        },
        "head": {
          "rotation": ["-math.clamp(query.ground_speed, 0, 8) * 1.5", 0, 0]
        },
        "tail1": {
          "rotation": ["-math.clamp(query.ground_speed, 0, 8) * 3", 0, 0]
        },
        "wing_l": {
          "rotation": [0, 0, "math.sin(query.life_time * 420) * 10"]
        },
        "wing_r": {
          "rotation": [0, 0, "-math.sin(query.life_time * 420) * 10"]
        }
      }
    },

    "animation.shadow_guardian.attack": {
      "loop": true,
      "bones": {
        "arm_l": {
          "rotation": ["-70 * math.sin(variable.attack_time * 180)", 0, 0]
        },
        "arm_r": {
          "rotation": ["-70 * math.sin(variable.attack_time * 180)", 0, 0]
        },
        "head": {
          "rotation": ["10 * math.sin(variable.attack_time * 180)", 0, 0]
        }
      }
    }
  }
}
