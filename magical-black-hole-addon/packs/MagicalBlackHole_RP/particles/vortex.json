{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "blackhole:vortex",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/black_hole_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 1
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + variable.particle_random_1 * 0.6"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_random_2 * 360.0 + variable.particle_age * 320.0) * math.max(variable.size, 0.3) * (1.6 + variable.particle_random_3 * 1.2) * (1.0 - variable.particle_age / variable.particle_lifetime)",
          "(variable.particle_random_4 - 0.5) * math.max(variable.size, 0.3) * 0.5 * (1.0 - variable.particle_age / variable.particle_lifetime)",
          "math.sin(variable.particle_random_2 * 360.0 + variable.particle_age * 320.0) * math.max(variable.size, 0.3) * (1.6 + variable.particle_random_3 * 1.2) * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.08 + variable.particle_random_4 * 0.08) * math.max(variable.size, 0.5)",
          "(0.08 + variable.particle_random_4 * 0.08) * math.max(variable.size, 0.5)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [
            [0.55, 0.2, 1.0, 0.0],
            [0.75, 0.3, 1.0, 1.0],
            [1.0, 0.4, 0.7, 1.0],
            [1.0, 0.7, 0.3, 1.0],
            [1.0, 1.0, 0.9, 0.9]
          ],
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
