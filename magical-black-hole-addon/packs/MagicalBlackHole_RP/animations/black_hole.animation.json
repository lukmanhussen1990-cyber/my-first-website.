{
  "format_version": "1.8.0",
  "animations": {
    "animation.blackhole.black_hole.idle": {
      "loop": true,
      "bones": {
        "root": {
          "scale": "variable.visual_size * (1.0 + 0.04 * math.sin(query.life_time * 400.0))"
        },
        "core": {
          "rotation": [0, "query.life_time * 45.0", 0]
        },
        "disk": {
          "rotation": [0, "query.life_time * 120.0", 0]
        },
        "ring": {
          "rotation": [0, "query.life_time * -70.0", 0]
        }
      }
    }
  }
}
