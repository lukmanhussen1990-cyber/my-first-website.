{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ag.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.2,
          "transitions": [
            {
              "moving": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "moving": {
          "animations": ["walk"],
          "blend_transition": 0.2,
          "transitions": [
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ]
        }
      }
    }
  }
}
