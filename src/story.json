  "lines": [
    {
      "id": "s01",
      "voice": "narrator",
      "text": "Night shift. 2:58 AM. You're closing alone.",
      "say": "Night shift.\nTwo fifty-eight, [A](/ˈA/) [M](/ˈɛm/).\nYou're closing alone.",
      "pause": 0.38
    },
    {
      "id": "s02",
      "voice": "narrator",
      "text": "Someone is dancing outside."
    },
    {
      "id": "s03",
      "voice": "narrator",
      "text": "But there's no music."
    },
    {
      "id": "s04",
      "voice": "narrator",
      "text": "You look away for one second. She's closer.",
      "say": "You look away for one second.\nShe's closer.",
      "pause": 0.5
    },
    {
      "id": "s05",
      "voice": "narrator",
      "text": "You run and lock the door."
    },
    {
      "id": "s06",
      "voice": "narrator",
      "text": "She's right at the glass."
    },
    {
      "id": "s07",
      "voice": "narrator",
      "text": "You hide behind the counter."
    },
    {
      "id": "s08",
      "voice": "narrator",
      "text": "Then you realize. She only moves when you look away.",
      "say": "Then you realize.\nShe only moves when you look away.",
      "pause": 0.55
    },
    {
      "id": "s09",
      "voice": "narrator",
      "text": "The window is empty."
    },
    {
      "id": "s10w",
      "voice": "whisper",
      "text": "Why did you stop watching?"
    },
    {
      "id": "s10",
      "voice": "narrator",
      "text": "Don't. Turn. Around.",
      "say": "Don't.\nTurn.\nAround.",
      "pause": 0.42
    },
    {
      "id": "s11",
      "voice": "narrator",
      "text": "Turn around… or keep watching her reflection? Comment A or B.",
      "say": "Turn around...\nor keep watching her reflection?\nComment, [A](/ˈA/), or [B](/bˈi/).",
      "pause": 0.38
    }
  ],
