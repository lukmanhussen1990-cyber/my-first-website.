{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "myc:infected_runner",
      "is_spawnable": true,
      "is_summonable": true
    },

    "component_groups": {
      "myc:culled": {
        "minecraft:instant_despawn": {}
      },
      "myc:sprinting": {
        "minecraft:movement": {
          "value": 0.42
        },
        "minecraft:behavior.leap_at_target": {
          "priority": 4,
          "must_be_on_ground": false,
          "yd": 0.55
        },
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "value": 1.5,
          "range": 3.0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": { "test": "has_target", "subject": "self", "operator": "==", "value": false },
              "event": "myc:stop_sprint"
            }
          ]
        }
      },
      "myc:loping": {
        "minecraft:movement": {
          "value": 0.28
        },
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "value": 4.0,
          "range": 7.0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": { "test": "has_target", "subject": "self", "operator": "==", "value": true },
              "event": "myc:start_sprint"
            }
          ]
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "myc_infected", "myc_runner", "monster", "undead", "mob" ]
      },
      "minecraft:health": {
        "value": 14,
        "max": 14
      },
      "minecraft:attack": {
        "damage": 4
      },
      "minecraft:knockback_resistance": {
        "value": 0.0
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_break_doors": false,
        "avoid_water": true,
        "avoid_portals": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 1.85
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/infected_runner.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 8 : 0"
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 48,
          "max_distance": 128
        },
        "min_range_inactivity_timer": 45
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": true,
            "damage_multiplier": 0.35
          },
          {
            "cause": "entity_explosion",
            "deals_damage": false,
            "on_damage": {
              "filters": {
                "test": "is_family", "subject": "other", "value": "myc_infected"
              }
            }
          }
        ]
      },

      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "alert_same_type": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "must_see_forget_duration": 25.0,
        "reselect_targets": true,
        "within_radius": 30.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "villager" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "speed_multiplier": 1.15,
        "reach_multiplier": 1.4,
        "cooldown_time": 0.6,
        "random_stop_interval": 0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 10.0,
        "probability": 0.05
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "myc:loping" ] }
      },
      "myc:start_sprint": {
        "remove": { "component_groups": [ "myc:loping" ] },
        "add": { "component_groups": [ "myc:sprinting" ] }
      },
      "myc:stop_sprint": {
        "remove": { "component_groups": [ "myc:sprinting" ] },
        "add": { "component_groups": [ "myc:loping" ] }
      },
      "myc:cull": {
        "add": { "component_groups": [ "myc:culled" ] }
      }
    }
  }
}
