{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "myc:nest_core",
      "is_spawnable": false,
      "is_summonable": true
    },

    "component_groups": {
      "myc:culled": {
        "minecraft:instant_despawn": {}
      },
      "myc:dormant": {
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "value": 12.0,
          "range": 10.0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": { "test": "is_daytime", "subject": "self", "operator": "==", "value": false },
              "event": "myc:wake"
            }
          ]
        }
      },
      "myc:active": {
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "value": 4.0,
          "range": 4.0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": { "test": "is_daytime", "subject": "self", "operator": "==", "value": true },
              "event": "myc:sleep"
            }
          ]
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [ "myc_nest", "myc_structure", "mob" ]
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 0.9
      },
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/nest_core.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 15 : 0"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "entity_explosion",
            "deals_damage": false,
            "on_damage": {
              "filters": {
                "test": "is_family", "subject": "other", "value": "myc_infected"
              }
            }
          },
          {
            "cause": "entity_attack",
            "deals_damage": false,
            "on_damage": {
              "filters": {
                "test": "is_family", "subject": "other", "value": "myc_infected"
              }
            }
          }
        ]
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "myc:active" ] }
      },
      "myc:wake": {
        "remove": { "component_groups": [ "myc:dormant" ] },
        "add": { "component_groups": [ "myc:active" ] }
      },
      "myc:sleep": {
        "remove": { "component_groups": [ "myc:active" ] },
        "add": { "component_groups": [ "myc:dormant" ] }
      },
      "myc:cull": {
        "add": { "component_groups": [ "myc:culled" ] }
      }
    }
  }
}
