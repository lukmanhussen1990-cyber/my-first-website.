 "captions": [
  {
   "scene": 1,
   "text": "NIGHT SHIFT. 2:58 AM.",
   "red": "2:58",
   "start": 1.4869389963167587,
   "end": 4.892938996316759
  },
  {
   "scene": 1,
   "text": "YOU'RE CLOSING ALONE.",
   "red": null,
   "start": 4.892938996316759,
   "end": 7.233333333333333
  },
  {
   "scene": 2,
   "text": "SOMEONE IS DANCING OUTSIDE.",
   "red": null,
   "start": 8.349951197053407,
   "end": 11.466666666666667
  },
  {
   "scene": 3,
   "text": "BUT THERE'S NO MUSIC.",
   "red": "MUSIC",
   "start": 14.135719459791284,
   "end": 17.733333333333334
  },
  {
   "scene": 4,
   "text": "YOU LOOK AWAY FOR ONE SECOND.",
   "red": null,
   "start": 18.33684653161449,
   "end": 20.69584653161449
  },
  {
   "scene": 4,
   "text": "SHE'S CLOSER.",
   "red": "CLOSER",
   "start": 20.69584653161449,
   "end": 23.1
  },
  {
   "scene": 5,
   "text": "YOU LOCK THE DOOR.",
   "red": null,
   "start": 23.605975598526705,
   "end": 27.166666666666668
  },
  {
   "scene": 6,
   "text": "SHE'S AT THE GLASS.",
   "red": null,
   "start": 27.78109653161449,
   "end": 31.366666666666667
  },
  {
   "scene": 7,
   "text": "YOU HIDE.",
   "red": null,
   "start": 32.173630064456724,
   "end": 35.7
  },
  {
   "scene": 8,
   "text": "THEN YOU REALIZE.",
   "red": null,
   "start": 36.92586379680786,
   "end": 38.89486379680786
  },
  {
   "scene": 8,
   "text": "SHE ONLY MOVES WHEN YOU LOOK AWAY.",
   "red": "LOOK",
   "start": 38.89486379680786,
   "end": 42.03333333333333
  },
  {
   "scene": 9,
   "text": "THE WINDOW IS EMPTY.",
   "red": "EMPTY",
   "start": 43.838339395334565,
   "end": 47
  },
  {
   "scene": 10,
   "text": "DON'T TURN AROUND.",
   "red": null,
   "start": 52.177622391037445,
   "wordTimes": [
    52.217622391037445,
    53.21062239103745,
    54.27162239103745
   ],
   "end": 55.7
  },
  {
   "scene": 11,
   "text": "TURN AROUND…",
   "red": null,
   "start": 55.90286279926336,
   "end": 57.34586279926336
  },
  {
   "scene": 11,
   "text": "OR KEEP WATCHING HER REFLECTION?",
