{
 "source": "user upload",
 "duration": 56.99,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You're thirty years old.",
   "start": 0.285,
   "end": 1.73
  },
  {
   "i": 2,
   "who": "N",
   "text": "And you just pooped.",
   "start": 2.15,
   "end": 3.545
  },
  {
   "i": 3,
   "who": "N",
   "text": "As usual, you yell...",
   "start": 4.065,
   "end": 5.565
  },
  {
   "i": 4,
   "who": "YOU",
   "text": "MOM! I'M DONE!",
   "start": 5.985,
   "end": 7.675
  },
  {
   "i": 5,
   "who": "N",
   "text": "Mom comes with the mug.",
   "start": 8.245,
   "end": 9.56
  },
  {
   "i": 6,
   "who": "N",
   "text": "Then the doorbell rings.",
   "start": 10.21,
   "end": 11.61
  },
  {
   "i": 7,
   "who": "N",
   "text": "It's your rich aunty.",
   "start": 12.115,
   "end": 13.325
  },
  {
   "i": 8,
   "who": "N",
   "text": "From Dubai.",
   "start": 14.025,
   "end": 14.85
  },
  {
   "i": 9,
   "who": "N",
   "text": "Mom drops the mug.",
   "start": 15.385,
   "end": 16.615
  },
  {
   "i": 10,
   "who": "N",
   "text": "And runs.",
   "start": 17.035,
   "end": 17.88
  },
  {
   "i": 11,
   "who": "N",
   "text": "She forgot one thing.",
   "start": 18.3,
   "end": 19.75
  },
  {
   "i": 12,
   "who": "N",
   "text": "You.",
   "start": 20.55,
   "end": 20.9
  },
  {
   "i": 13,
   "who": "N",
   "text": "Ten minutes.",
   "start": 21.7,
   "end": 22.37
  },
  {
   "i": 14,
   "who": "YOU",
   "text": "MOM!",
   "start": 22.87,
   "end": 23.53
  },
  {
   "i": 15,
   "who": "N",
   "text": "The pressure cooker is louder.",
   "start": 23.95,
   "end": 25.595
  },
  {
   "i": 16,
   "who": "N",
   "text": "One hour.",
   "start": 26.345,
   "end": 27.055
  },
  {
   "i": 17,
   "who": "N",
   "text": "Your legs go numb.",
   "start": 27.475,
   "end": 28.75
  },
  {
   "i": 18,
   "who": "N",
   "text": "Grandpa walks past the door.",
   "start": 29.17,
   "end": 30.69
  },
  {
   "i": 19,
   "who": "N",
   "text": "He pretends he didn't hear.",
   "start": 31.11,
   "end": 32.43
  },
  {
   "i": 20,
   "who": "N",
   "text": "Two hours.",
   "start": 33.23,
   "end": 34.03
  },
  {
   "i": 21,
   "who": "N",
   "text": "Aunty asks one question.",
   "start": 34.45,
   "end": 36.285
  },
  {
   "i": 22,
   "who": "AUNTY",
   "text": "Where is the toilet?",
   "start": 36.785,
   "end": 37.82
  },
  {
   "i": 23,
   "who": "N",
   "text": "The door has no lock.",
   "start": 38.27,
   "end": 39.745
  },
  {
   "i": 24,
   "who": "N",
   "text": "The handle turns.",
   "start": 40.165,
   "end": 41.3
  },
  {
   "i": 25,
   "who": "N",
   "text": "Slowly.",
   "start": 42.05,
   "end": 42.845
  },
  {
   "i": 26,
   "who": "N",
   "text": "She looks at you.",
   "start": 43.32,
   "end": 44.115
  },
  {
   "i": 27,
   "who": "N",
   "text": "You look at her.",
   "start": 44.6,
   "end": 45.665
  },
  {
   "i": 28,
   "who": "YOU",
   "text": "Aunty... can you pass the tissue?",
   "start": 46.315,
   "end": 48.37
  },
  {
   "i": 29,
   "who": "N",
   "text": "What you don't know...",
   "start": 49.27,
   "end": 50.3
  },
  {
   "i": 30,
   "who": "N",
   "text": "Aunty was writing her will today.",
   "start": 50.72,
   "end": 52.705
  },
  {
   "i": 31,
   "who": "N",
   "text": "Your name was in it.",
   "start": 53.125,
   "end": 54.205
  },
  {
   "i": 32,
   "who": "N",
   "text": "Was.",
   "start": 55.105,
   "end": 55.6
  }
 ]
}