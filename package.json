{
  "name": "nyxen-tx1-flashlight",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive, physically based 3D tactical flashlight showcase built with React Three Fiber.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
