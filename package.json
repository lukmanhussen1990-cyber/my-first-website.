    "preview": "vite preview",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "maath": "0.10.8",
    "postprocessing": "6.39.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
