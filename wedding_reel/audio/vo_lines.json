 },
 "duration": 61.066,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You're thirty-two years old.",
   "start": 0.285,
   "end": 1.96
  },
  {
   "i": 2,
   "who": "N",
   "text": "You just pooped at your cousin's wedding.",
   "start": 2.285,
   "end": 4.085
  },
  {
   "i": 3,
   "who": "N",
   "text": "And from the toilet, you yell:",
   "start": 4.415,
   "end": 5.735
  },
  {
   "i": 4,
   "who": "Y",
   "text": "MOM! I'M DONE!",
   "start": 6.035,
   "end": 7.835
  },
  {
   "i": 5,
   "who": "N",
   "text": "The DJ stops the music.",
   "start": 8.435,
   "end": 10.105
  },
  {
   "i": 6,
   "who": "N",
   "text": "Two hundred guests turn around.",
   "start": 10.435,
   "end": 12.27
  },
  {
   "i": 7,
   "who": "N",
   "text": "Then you remember.",
   "start": 12.6,
   "end": 13.46
  },
  {
   "i": 8,
   "who": "N",
   "text": "Mom left an hour ago.",
   "start": 13.79,
   "end": 15.235
  },
  {
   "i": 9,
   "who": "N",
   "text": "Silence.",
   "start": 15.565,
   "end": 16.35
  },
  {
   "i": 10,
   "who": "N",
   "text": "The uncles look at each other.",
   "start": 17.2,
   "end": 18.58
  },
  {
   "i": 11,
   "who": "N",
   "text": "Nobody moves.",
   "start": 18.91,
   "end": 19.995
  },
  {
   "i": 12,
   "who": "N",
   "text": "The bride stops smiling.",
   "start": 20.325,
   "end": 21.715
  },
  {
   "i": 13,
   "who": "N",
   "text": "The groom pretends to check his phone.",
   "start": 22.045,
   "end": 23.78
  },
  {
   "i": 14,
   "who": "N",
   "text": "Grandpa pretends to be asleep.",
   "start": 24.11,
   "end": 25.775
  },
  {
   "i": 15,
   "who": "N",
   "text": "You yell again.",
   "start": 26.105,
   "end": 27.035
  },
  {
   "i": 16,
   "who": "N",
   "text": "Louder.",
   "start": 27.305,
   "end": 27.91
  },
  {
   "i": 17,
   "who": "Y",
   "text": "MOM! I'M DOOONE!",
   "start": 28.21,
   "end": 31.351
  },
  {
   "i": 18,
   "who": "N",
   "text": "A baby starts crying.",
   "start": 31.951,
   "end": 33.431
  },
  {
   "i": 19,
   "who": "N",
   "text": "What you don't know:",
   "start": 34.431,
   "end": 35.436
  },
  {
   "i": 20,
   "who": "N",
   "text": "most kids learn to wipe on their own by age five or six.",
   "start": 35.756,
   "end": 38.756
  },
  {
   "i": 21,
   "who": "N",
   "text": "You're thirty-two.",
   "start": 39.086,
   "end": 40.206
  },
  {
   "i": 22,
   "who": "N",
   "text": "The family makes a circle.",
   "start": 40.536,
   "end": 41.976
  },
  {
   "i": 23,
   "who": "N",
   "text": "Rock.",
   "start": 42.306,
   "end": 42.721
  },
  {
   "i": 24,
   "who": "N",
   "text": "Paper.",
   "start": 43.141,
   "end": 43.544
  },
  {
   "i": 25,
   "who": "N",
   "text": "Scissors.",
   "start": 43.964,
   "end": 44.646
  },
  {
   "i": 26,
   "who": "N",
   "text": "Everyone throws rock.",
   "start": 44.976,
   "end": 46.136
  },
  {
   "i": 27,
   "who": "N",
   "text": "Except the groom.",
   "start": 46.416,
   "end": 47.251
  },
  {
   "i": 28,
   "who": "N",
   "text": "He throws scissors.",
   "start": 48.501,
   "end": 49.511
  },
  {
   "i": 29,
   "who": "N",
   "text": "On his own wedding day.",
   "start": 49.811,
   "end": 51.286
  },
  {
   "i": 30,
   "who": "N",
   "text": "He walks to the toilet.",
   "start": 51.616,
   "end": 52.851
  },
  {
   "i": 31,
   "who": "N",
   "text": "Slowly.",
   "start": 53.401,
   "end": 54.056
  },
  {
   "i": 32,
   "who": "N",
   "text": "The DJ plays a sad song.",
   "start": 54.386,
   "end": 56.256
  },
  {
   "i": 33,
   "who": "N",
   "text": "Congratulations to the happy couple.",
   "start": 57.356,
   "end": 59.376
  }
 ]
}