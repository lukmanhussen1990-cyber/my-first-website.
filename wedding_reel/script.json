  {
   "id": 28,
   "text": "Everyone throws rock."
  },
  {
   "id": 29,
   "text": "Except the bride."
  },
  {
   "id": 30,
   "text": "She throws scissors."
  },
  {
   "id": 31,
   "text": "On her wedding day."
  },
  {
   "id": 32,
   "text": "She lifts her dress. And walks down the aisle."
  },
  {
   "id": 33,
   "text": "The wrong way."
  },
  {
