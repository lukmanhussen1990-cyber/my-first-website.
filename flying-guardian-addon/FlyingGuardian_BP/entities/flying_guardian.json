{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "fguard:flying_guardian",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "fguard:diving": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "fguard:wild": {
        "minecraft:variant": {
          "value": 0
        },
        "minecraft:attack": {
          "damage": [8, 12]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3,
          "speed_multiplier": 1.8,
          "track_target": true,
          "horizontal_reach": 1.0,
          "cooldown_time": 1.25,
          "melee_fov": 180
        },
        "minecraft:behavior.random_hover": {
          "priority": 7,
          "xz_dist": 10,
          "y_dist": 4,
          "y_offset": -1,
          "interval": 30,
          "speed_multiplier": 0.8,
          "hover_height": [3, 8]
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "has_target", "subject": "self", "value": true },
                  { "test": "has_component", "subject": "self", "value": "minecraft:tameable" }
                ]
              },
              "event": "fguard:become_hostile"
            },
            {
              "filters": {
                "all_of": [
                  { "test": "has_target", "subject": "self", "value": false },
                  { "test": "has_component", "subject": "self", "operator": "!=", "value": "minecraft:tameable" }
                ]
              },
              "event": "fguard:become_calm"
            }
          ]
        }
      },

      "fguard:wild_tameable": {
        "minecraft:tameable": {
          "probability": 0.33,
          "tame_items": ["emerald"],
          "tame_event": {
            "event": "fguard:on_tame",
            "target": "self"
          }
        }
      },

      "fguard:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:attack": {
          "damage": [20, 26]
        },
        "minecraft:sittable": {
          "sit_event": {
            "event": "fguard:on_sit",
            "target": "self"
          },
          "stand_event": {
            "event": "fguard:on_stand",
            "target": "self"
          }
        },
        "minecraft:healable": {
          "items": [
            { "item": "rotten_flesh", "heal_amount": 10 },
            { "item": "beef", "heal_amount": 12 },
            { "item": "cooked_beef", "heal_amount": 24 },
            { "item": "porkchop", "heal_amount": 12 },
            { "item": "cooked_porkchop", "heal_amount": 24 },
            { "item": "mutton", "heal_amount": 10 },
            { "item": "cooked_mutton", "heal_amount": 20 },
            { "item": "chicken", "heal_amount": 8 },
            { "item": "cooked_chicken", "heal_amount": 18 },
            { "item": "rabbit", "heal_amount": 8 },
            { "item": "cooked_rabbit", "heal_amount": 18 },
            { "item": "emerald", "heal_amount": 50 }
          ]
        },
        "minecraft:behavior.stay_while_sitting": {
          "priority": 1
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3,
          "speed_multiplier": 2.0,
          "track_target": true,
          "horizontal_reach": 1.2,
          "cooldown_time": 0.8,
          "melee_fov": 180
        },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.8,
          "start_distance": 6,
          "stop_distance": 3,
          "can_teleport": true,
          "ignore_vibration": true
        },
        "minecraft:behavior.random_hover": {
          "priority": 7,
          "xz_dist": 4,
          "y_dist": 3,
          "y_offset": 0,
          "interval": 60,
          "speed_multiplier": 0.8,
          "hover_height": [2, 4]
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "flying_guardian" }
                ]
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "flying_guardian" }
                ]
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      { "test": "is_family", "subject": "other", "value": "monster" },
                      { "test": "is_family", "subject": "other", "value": "hoglin" }
                    ]
                  },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "enderman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "zombie_pigman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "spider" },
                  {
                    "none_of": [
                      {
                        "all_of": [
                          { "test": "is_family", "subject": "other", "value": "piglin" },
                          { "test": "is_family", "subject": "other", "operator": "!=", "value": "piglin_brute" }
                        ]
                      }
                    ]
                  }
                ]
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": true,
          "must_see_forget_duration": 5.0,
          "reselect_targets": true,
          "scan_interval": 10,
          "within_radius": 24.0,
          "target_search_height": 14.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "any_of": [
                      { "test": "is_family", "subject": "other", "value": "monster" },
                      { "test": "is_family", "subject": "other", "value": "hoglin" }
                    ]
                  },
                  { "test": "has_target", "subject": "other", "value": true },
                  { "test": "is_underwater", "subject": "other", "operator": "!=", "value": true },
                  {
                    "none_of": [
                      {
                        "all_of": [
                          { "test": "is_family", "subject": "other", "value": "piglin" },
                          { "test": "is_family", "subject": "other", "operator": "!=", "value": "piglin_brute" }
                        ]
                      }
                    ]
                  }
                ]
              },
              "max_dist": 24
            }
          ]
        }
      },

      "fguard:mode_follow": {
        "minecraft:mark_variant": {
          "value": 0
        }
      },

      "fguard:mode_stay": {
        "minecraft:mark_variant": {
          "value": 1
        }
      },

      "fguard:leashed": {
        "minecraft:skin_id": {
          "value": 1
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["flying_guardian", "mob"]
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.9
      },
      "minecraft:health": {
        "value": 200,
        "max": 200
      },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:flying_speed": {
        "value": 0.35
      },
      "minecraft:follow_range": {
        "value": 48,
        "max": 48
      },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_path_over_lava": true,
        "can_sink": false,
        "can_pass_doors": true,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_portals": true,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:can_fly": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 0.75
      },
      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "fly_into_wall",
            "deals_damage": false
          },
          {
            "cause": "suffocation",
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "is_owner", "subject": "other", "value": true }
                ]
              }
            },
            "deals_damage": false
          },
          {
            "deals_damage": true,
            "damage_multiplier": 0.65
          }
        ]
      },
      "minecraft:nameable": {},
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 6.0,
        "max_distance": 10.0,
        "on_leash": {
          "event": "fguard:on_leash",
          "target": "self"
        },
        "on_unleash": {
          "event": "fguard:on_unleash",
          "target": "self"
        }
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/flying_guardian.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(15, 25) : 0"
      },
      "minecraft:ambient_sound_interval": {
        "value": 10.0,
        "range": 16.0,
        "event_name": "ambient"
      },
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 10,
        "probability": 0.03
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["fguard:wild", "fguard:wild_tameable"]
        }
      },
      "fguard:become_hostile": {
        "remove": {
          "component_groups": ["fguard:wild_tameable"]
        }
      },
      "fguard:become_calm": {
        "add": {
          "component_groups": ["fguard:wild_tameable"]
        }
      },
      "fguard:on_tame": {
        "remove": {
          "component_groups": ["fguard:wild", "fguard:wild_tameable"]
        },
        "add": {
          "component_groups": ["fguard:tamed", "fguard:mode_follow"]
        }
      },
      "fguard:on_sit": {
        "remove": {
          "component_groups": ["fguard:mode_follow"]
        },
        "add": {
          "component_groups": ["fguard:mode_stay"]
        }
      },
      "fguard:on_stand": {
        "remove": {
          "component_groups": ["fguard:mode_stay"]
        },
        "add": {
          "component_groups": ["fguard:mode_follow"]
        }
      },
      "fguard:on_leash": {
        "add": {
          "component_groups": ["fguard:leashed"]
        }
      },
      "fguard:on_unleash": {
        "remove": {
          "component_groups": ["fguard:leashed"]
        }
      }
    }
  }
}
