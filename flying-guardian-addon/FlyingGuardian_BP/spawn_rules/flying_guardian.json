{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "fguard:flying_guardian",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:difficulty_filter": {
          "min": "peaceful",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 2
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:density_limit": {
          "surface": 1
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "all_of": [
                { "test": "has_biome_tag", "operator": "==", "value": "mountains" },
                { "test": "has_biome_tag", "operator": "!=", "value": "meadow" },
                { "test": "has_biome_tag", "operator": "!=", "value": "cherry_grove" }
              ]
            },
            { "test": "has_biome_tag", "operator": "==", "value": "extreme_hills" }
          ]
        }
      },
      {
        "minecraft:spawns_underground": {},
        "minecraft:difficulty_filter": {
          "min": "peaceful",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 3
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:density_limit": {
          "underground": 1
        },
        "minecraft:biome_filter": {
          "test": "has_biome_tag",
          "operator": "==",
          "value": "nether"
        }
      }
    ]
  }
}
