{
 "takes": {
  "N": "my_voiceover"
 },
 "duration": 56.529,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You're staying at your friend's house.",
   "start": 0.07,
   "end": 1.57
  },
  {
   "i": 2,
   "who": "N",
   "text": "And you haven't pooped in five days.",
   "start": 1.98,
   "end": 4.27
  },
  {
   "i": 3,
   "who": "N",
   "text": "Your stomach is a balloon.",
   "start": 4.6,
   "end": 6.37
  },
  {
   "i": 4,
   "who": "N",
   "text": "Your friend's mom thinks you're pregnant.",
   "start": 6.81,
   "end": 8.59
  },
  {
   "i": 5,
   "who": "N",
   "text": "You go to the doctor.",
   "start": 9.08,
   "end": 9.99
  },
  {
   "i": 6,
   "who": "N",
   "text": "He presses your stomach.",
   "start": 10.48,
   "end": 11.58
  },
  {
   "i": 7,
   "who": "N",
   "text": "Hmm.",
   "start": 11.99,
   "end": 12.67
  },
  {
   "i": 8,
   "who": "N",
   "text": "Very serious.",
   "start": 13.04,
   "end": 14.21
  },
  {
   "i": 9,
   "who": "N",
   "text": "He gives you the strongest medicine.",
   "start": 14.66,
   "end": 16.47
  },
  {
   "i": 10,
   "who": "N",
   "text": "Take one.",
   "start": 16.79,
   "end": 17.31
  },
  {
   "i": 11,
   "who": "Y",
   "text": "ONLY ONE.",
   "start": 17.68,
   "end": 18.46
  },
  {
   "i": 12,
   "who": "N",
   "text": "You take three.",
   "start": 18.88,
   "end": 19.74
  },
  {
   "i": 13,
   "who": "N",
   "text": "You sit in the waiting room.",
   "start": 20.27,
   "end": 21.33
  },
  {
   "i": 14,
   "who": "N",
   "text": "Nothing.",
   "start": 21.9,
   "end": 22.33
  },
  {
   "i": 15,
   "who": "N",
   "text": "One minute.",
   "start": 22.87,
   "end": 23.41
  },
  {
   "i": 16,
   "who": "N",
   "text": "Nothing.",
   "start": 23.9,
   "end": 24.34
  },
  {
   "i": 17,
   "who": "N",
   "text": "Then…",
   "start": 24.92,
   "end": 25.35
  },
  {
   "i": 18,
   "who": "N",
   "text": "Your stomach starts talking.",
   "start": 25.77,
   "end": 27.25
  },
  {
   "i": 19,
   "who": "Y",
   "text": "LOUD.",
   "start": 27.59,
   "end": 28.23
  },
  {
   "i": 20,
   "who": "N",
   "text": "Everyone in the waiting room looks at you.",
   "start": 28.71,
   "end": 30.36
  },
  {
   "i": 21,
   "who": "N",
   "text": "You run to the toilet.",
   "start": 30.83,
   "end": 31.86
  },
  {
   "i": 22,
   "who": "N",
   "text": "There's a line.",
   "start": 32.27,
   "end": 32.99
  },
  {
   "i": 23,
   "who": "N",
   "text": "Ten people.",
   "start": 33.28,
   "end": 34.08
  },
  {
   "i": 24,
   "who": "N",
   "text": "You can't wait!",
   "start": 34.41,
   "end": 35.22
  },
  {
   "i": 25,
   "who": "Y",
   "text": "PLEASE! IT'S AN EMERGENCY!",
   "start": 35.5,
   "end": 37.4
  },
  {
   "i": 26,
   "who": "N",
   "text": "The door opens.",
   "start": 37.79,
   "end": 38.71
  },
  {
   "i": 27,
   "who": "N",
   "text": "It's the doctor.",
   "start": 39.07,
   "end": 39.81
  },
  {
   "i": 28,
   "who": "N",
   "text": "Then…",
   "start": 40.22,
   "end": 40.63
  },
  {
   "i": 29,
   "who": "N",
   "text": "It happens.",
   "start": 40.95,
   "end": 41.72
  },
  {
   "i": 30,
   "who": "N",
   "text": "Right there.",
   "start": 42.03,
   "end": 42.71
  },
  {
   "i": 31,
   "who": "N",
   "text": "On the doctor's new shoes.",
   "start": 42.97,
   "end": 44.55
  },
  {
   "i": 32,
   "who": "N",
   "text": "Silence.",
   "start": 45.09,
   "end": 45.82
  },
  {
   "i": 33,
   "who": "N",
   "text": "The waiting room is empty in three seconds.",
   "start": 46.26,
   "end": 48.63
  },
  {
   "i": 34,
   "who": "N",
   "text": "Well…",
   "start": 48.98,
   "end": 49.43
  },
  {
   "i": 35,
   "who": "N",
   "text": "The medicine works!",
   "start": 49.75,
   "end": 50.75
  },
  {
   "i": 36,
   "who": "N",
   "text": "Then he writes your bill.",
   "start": 51.17,
   "end": 52.28
  },
  {
   "i": 37,
   "who": "N",
   "text": "Treatment:",
   "start": 52.74,
   "end": 53.21
  },
  {
   "i": 38,
   "who": "N",
   "text": "$50.",
   "start": 53.44,
   "end": 54.27
  },
  {
   "i": 39,
   "who": "N",
   "text": "New shoes:",
   "start": 54.64,
   "end": 55.29
  },
  {
   "i": 40,
   "who": "N",
   "text": "$500.",
   "start": 55.57,
   "end": 56.32
  }
 ]
}