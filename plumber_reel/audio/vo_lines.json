 },
 "duration": 57.94,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You just shit so hard at your friend's house…",
   "start": 0.055,
   "end": 2.52
  },
  {
   "i": 2,
   "who": "N",
   "text": "it doesn't fit.",
   "start": 3.025,
   "end": 3.84
  },
  {
   "i": 3,
   "who": "N",
   "text": "You flush.",
   "start": 4.49,
   "end": 5.05
  },
  {
   "i": 4,
   "who": "N",
   "text": "Nothing.",
   "start": 5.44,
   "end": 5.845
  },
  {
   "i": 5,
   "who": "N",
   "text": "You flush again.",
   "start": 6.375,
   "end": 7.185
  },
  {
   "i": 6,
   "who": "N",
   "text": "It doesn't even move.",
   "start": 7.67,
   "end": 8.94
  },
  {
   "i": 7,
   "who": "N",
   "text": "It's just… sitting there.",
   "start": 9.155,
   "end": 10.495
  },
  {
   "i": 8,
   "who": "N",
   "text": "Looking at you.",
   "start": 10.845,
   "end": 11.655
  },
  {
   "i": 9,
   "who": "N",
   "text": "You grab the plunger.",
   "start": 12.295,
   "end": 13.23
  },
  {
   "i": 10,
   "who": "N",
   "text": "The plunger breaks.",
   "start": 13.64,
   "end": 14.62
  },
  {
   "i": 11,
   "who": "N",
   "text": "Your friend knocks.",
   "start": 15.1,
   "end": 15.69
  },
  {
   "i": 12,
   "who": "N",
   "text": "\"Bro, you good?\"",
   "start": 16.385,
   "end": 17.275
  },
  {
   "i": 13,
   "who": "N",
   "text": "You say: \"Yeah.\"",
   "start": 17.82,
   "end": 19.055
  },
  {
   "i": 14,
   "who": "N",
   "text": "You are not good.",
   "start": 19.5,
   "end": 20.875
  },
  {
   "i": 15,
   "who": "N",
   "text": "His mom calls a plumber.",
   "start": 21.415,
   "end": 22.55
  },
  {
   "i": 16,
   "who": "N",
   "text": "The whole family waits outside the door.",
   "start": 22.82,
   "end": 24.83
  },
  {
   "i": 17,
   "who": "N",
   "text": "Even grandma.",
   "start": 25.18,
   "end": 26.0
  },
  {
   "i": 18,
   "who": "N",
   "text": "The plumber arrives.",
   "start": 26.64,
   "end": 27.34
  },
  {
   "i": 19,
   "who": "N",
   "text": "He walks in.",
   "start": 27.92,
   "end": 28.575
  },
  {
   "i": 20,
   "who": "N",
   "text": "He looks down.",
   "start": 29.015,
   "end": 29.735
  },
  {
   "i": 21,
   "who": "N",
   "text": "He takes off his cap.",
   "start": 30.265,
   "end": 31.08
  },
  {
   "i": 22,
   "who": "N",
   "text": "He's been a plumber for thirty years.",
   "start": 31.79,
   "end": 33.62
  },
  {
   "i": 23,
   "who": "N",
   "text": "He's never seen this.",
   "start": 34.17,
   "end": 35.535
  },
  {
   "i": 24,
   "who": "N",
   "text": "What you don't know:",
   "start": 36.65,
   "end": 37.48
  },
  {
   "i": 25,
   "who": "N",
   "text": "the biggest fossil human poop ever found",
   "start": 37.97,
   "end": 40.45
  },
  {
   "i": 26,
   "who": "N",
   "text": "is about twenty centimetres long.",
   "start": 40.45,
   "end": 42.24
  },
  {
   "i": 27,
   "who": "N",
   "text": "It's over a thousand years old.",
   "start": 42.585,
   "end": 44.25
  },
  {
   "i": 28,
   "who": "N",
   "text": "And it's kept in a museum.",
   "start": 44.55,
   "end": 46.065
  },
  {
   "i": 29,
   "who": "N",
   "text": "The plumber pulls out a ruler.",
   "start": 46.715,
   "end": 48.045
  },
  {
   "i": 30,
   "who": "N",
   "text": "Then a bigger ruler.",
   "start": 48.38,
   "end": 49.545
  },
  {
   "i": 31,
   "who": "N",
   "text": "Then he takes a photo.",
   "start": 49.91,
   "end": 51.085
  },
  {
   "i": 32,
   "who": "N",
   "text": "\"Kid…",
   "start": 51.715,
   "end": 51.97
  },
  {
   "i": 33,
   "who": "N",
   "text": "I think you broke the record.\"",
   "start": 53.44,
   "end": 54.95
  }
 ]
}