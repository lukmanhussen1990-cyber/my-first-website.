{
 "voiceover": "audio/voiceover.mp3",
 "lines": [
  {"id": "01", "speaker": "NARRATOR", "text": "You wake up.", "segments": [["You wake up."]], "chunks": ["You wake up."], "gap": 0.6, "stretch": 0.6},
  {"id": "02", "speaker": "NARRATOR", "text": "Your first date is in ten minutes.", "segments": [["Your first date is in ten minutes."]], "chunks": ["Your first", "date is in", "ten minutes."], "gap": 0.7, "stretch": 0.8},
  {"id": "03", "speaker": "NARRATOR", "text": "You yawn.", "segments": [["You yawn."]], "chunks": ["You yawn."], "gap": 1.1, "stretch": 1.4},
  {"id": "04", "speaker": "NARRATOR", "text": "The mirror cracks.", "segments": [["The mirror cracks."]], "chunks": ["The mirror", "cracks."], "gap": 0.8, "stretch": 1.0},
  {"id": "05", "speaker": "NARRATOR", "text": "Your mouth smells like poop.", "segments": [["Your mouth smells like"], ["poop."]], "chunks": ["Your mouth", "smells like", "poop."], "gap": 0.7, "stretch": 0.8},
  {"id": "06", "speaker": "NARRATOR", "text": "You brush. Once. Twice. Five times.", "segments": [["You brush."], ["Once."], ["Twice."], ["Five times."]], "chunks": ["You brush.", "Once.", "Twice.", "Five times."], "gap": 0.7, "stretch": 1.2},
  {"id": "07", "speaker": "NARRATOR", "text": "You check. Still poop.", "segments": [["You check."], ["Still poop."]], "chunks": ["You check.", "Still poop."], "gap": 0.8, "stretch": 1.2},
  {"id": "08", "speaker": "NARRATOR", "text": "You eat a whole pack of mints.", "segments": [["You eat a whole pack of mints."]], "chunks": ["You eat", "a whole pack", "of mints."], "gap": 0.7, "stretch": 1.0},
  {"id": "09", "speaker": "NARRATOR", "text": "You gargle mouthwash.", "segments": [["You gargle mouthwash."]], "chunks": ["You gargle", "mouthwash."], "gap": 0.8, "stretch": 1.0},
  {"id": "10", "speaker": "NARRATOR", "text": "You check again.", "segments": [["You check again."]], "chunks": ["You check again."], "gap": 0.6, "stretch": 0.8},
  {"id": "11", "speaker": "NARRATOR", "text": "Fresh.", "segments": [["Fresh."]], "chunks": ["Fresh."], "gap": 0.8, "stretch": 0.8},
  {"id": "12", "speaker": "NARRATOR", "text": "You're late. You run.", "segments": [["You're late."], ["You run."]], "chunks": ["You're late.", "You run."], "gap": 1.1, "stretch": 1.6},
  {"id": "13", "speaker": "NARRATOR", "text": "She's there. She smiles.", "segments": [["She's there."], ["She smiles."]], "chunks": ["She's there.", "She smiles."], "gap": 0.5, "stretch": 0.8},
  {"id": "14", "speaker": "CRUSH", "text": "Hi!", "segments": [["Hi!"]], "chunks": ["Hi!"], "gap": 0.6, "stretch": 0.6},
  {"id": "15", "speaker": "NARRATOR", "text": "She leans in close.", "segments": [["She leans in close."]], "chunks": ["She leans", "in close."], "gap": 0.7, "stretch": 1.0},
  {"id": "16", "speaker": "NARRATOR", "text": "Your breath is perfect.", "segments": [["Your breath is"], ["perfect."]], "chunks": ["Your breath", "is perfect."], "gap": 0.9, "stretch": 0.8, "min_gap": 0.8},
  {"id": "17", "speaker": "NARRATOR", "text": "She stops. She sniffs.", "segments": [["She stops."], ["She sniffs."]], "chunks": ["She stops.", "She sniffs."], "gap": 0.5, "stretch": 0.5},
  {"id": "18", "speaker": "CRUSH", "text": "Why do your armpits smell like poop?", "segments": [["Why do your armpits smell like"], ["poop?"]], "chunks": ["Why do your", "armpits smell", "like poop?"], "gap": 0.7, "stretch": 0.8},
  {"id": "19", "speaker": "NARRATOR", "text": "You forgot one thing.", "segments": [["You forgot one thing."]], "chunks": ["You forgot", "one thing."], "gap": 0.7, "stretch": 0.8},
  {"id": "20", "speaker": "NARRATOR", "text": "You didn't shower.", "segments": [["You didn't shower."]], "chunks": ["You didn't", "shower."], "gap": 4.2, "stretch": 1.0, "min_tail": 4.0}
 ]
}
