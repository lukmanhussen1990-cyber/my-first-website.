{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:debris_chip",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/nd_chip"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.6)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * 0.28 * (variable.size > 0 ? variable.size : 1) * 1.0 * 1",
          "0.5 * 0.28 * (variable.size > 0 ? variable.size : 1) * 1.0 * 1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-25, 25)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#FF6E5B45",
            "0.8": "#FF6E5B45",
            "1": "#006E5B45"
          }
        }
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 6,
        "coefficient_of_restitution": 0.25,
        "collision_radius": 0.06,
        "expire_on_contact": false
      }
    }
  }
}