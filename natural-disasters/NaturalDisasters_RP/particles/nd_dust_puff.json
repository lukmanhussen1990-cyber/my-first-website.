{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:dust_puff",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/nd_puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.6)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.25,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * (variable.size > 0 ? variable.size : 1.5) * 1.0 * (1 + 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "0.5 * (variable.size > 0 ? variable.size : 1.5) * 1.0 * (1 + 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-25, 25)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#00A08A64",
            "0.2": "#A0A89070",
            "0.7": "#70A89070",
            "1": "#00A89070"
          }
        }
      }
    }
  }
}