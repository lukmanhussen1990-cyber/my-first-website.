{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:lava_glob",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/nd_soft"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 3.0)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -22,
          0
        ],
        "linear_drag_coefficient": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * (variable.size > 0 ? variable.size : 1.0) * 1.0 * 1",
          "0.5 * (variable.size > 0 ? variable.size : 1.0) * 1.0 * 1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#FFFFE060",
            "0.5": "#FFFF7A10",
            "0.9": "#FFC03000",
            "1": "#00600800"
          }
        }
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 8,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.1,
        "expire_on_contact": true
      }
    }
  }
}