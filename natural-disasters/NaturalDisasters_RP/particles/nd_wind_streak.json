{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:wind_streak",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/nd_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 0.7)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * 1.0 * (variable.size > 0 ? variable.size : 1) * 2.4 * 1",
          "0.5 * 1.0 * (variable.size > 0 ? variable.size : 1) * 0.05 * 1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#00FFFFFF",
            "0.25": "#60FFFFFF",
            "0.7": "#40FFFFFF",
            "1": "#00FFFFFF"
          }
        }
      }
    }
  }
}