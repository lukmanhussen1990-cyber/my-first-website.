{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:lightning_bolt",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/nd_bolt"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 0.35)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7 + 0.025 * (variable.size > 0 ? variable.size : 30)",
          "0.5 * (variable.size > 0 ? variable.size : 30)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#FFFFFFFF",
            "0.25": "#60C8D8FF",
            "0.4": "#FFFFFFFF",
            "0.7": "#80C8D8FF",
            "1": "#00B0C0FF"
          }
        }
      }
    }
  }
}