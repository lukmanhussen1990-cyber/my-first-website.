{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nd:rain_streak",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/nd_rain"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.vel.x",
          "variable.vel.y + 0.00001",
          "variable.vel.z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 1.2)"
      },
      "minecraft:particle_initial_speed": "20 * math.sqrt(variable.vel.x * variable.vel.x + variable.vel.y * variable.vel.y + variable.vel.z * variable.vel.z)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * 1.0 * (variable.size > 0 ? variable.size : 1) * 0.05 * 1",
          "0.5 * 1.0 * (variable.size > 0 ? variable.size : 1) * 1.1 * 1"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 4,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            4,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0": "#00B0C0E8",
            "0.1": "#A0B0C0E8",
            "0.9": "#80A0B0D8",
            "1": "#00A0B0D8"
          }
        }
      }
    }
  }
}