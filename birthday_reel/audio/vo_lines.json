   "start": 3.89,
   "end": 4.87
  },
  {
   "i": 4,
   "text": "Today is your nephew's sixth birthday.",
   "start": 5.29,
   "end": 7.605
  },
  {
   "i": 5,
   "text": "You just pooped.",
   "start": 8.025,
   "end": 8.9
  },
  {
   "i": 6,
   "text": "\"MOM!\"",
   "start": 9.15,
   "end": 9.94
