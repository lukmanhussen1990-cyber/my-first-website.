  },
  {
   "t0": 11.66,
   "t1": 12.76,
   "text": "is shaking."
  },
  {
   "t0": 12.76,
   "t1": 13.78,
   "text": "\"...forever.\""
  },
  {
   "t0": 13.78,
   "t1": 15.38,
   "text": "The priest leans in."
  },
  {
   "t0": 15.38,
   "t1": 16.54,
   "text": "He sniffs."
  },
  {
   "t0": 16.54,
   "t1": 17.86,
   "text": "He leans back."
  },
  {
   "t0": 17.86,
   "t1": 18.48,
   "text": "The photographer"
  },
  {
   "t0": 18.48,
   "t1": 19.92,
   "text": "moves closer."
  },
  {
   "t0": 19.92,
   "t1": 20.95,
   "text": "Close-up."
  },
  {
   "t0": 20.95,
   "t1": 21.66,
   "text": "Click."
  },
  {
   "t0": 21.66,
   "t1": 22.31,
   "text": "Click. Click."
  },
  {
   "t0": 22.31,
   "t1": 23.07,
   "text": "Click. Click. Click."
  },
  {
   "t0": 23.07,
   "t1": 24.72,
   "text": "She holds your hands."
  },
  {
   "t0": 24.72,
   "t1": 26.18,
   "text": "She starts crying."
  },
  {
   "t0": 26.18,
   "t1": 27.34,
   "text": "Happy tears."
  },
  {
   "t0": 27.34,
   "t1": 28.68,
   "text": "Then she sniffs."
  },
  {
   "t0": 28.68,
   "t1": 30.02,
   "text": "The tears stop."
  },
  {
   "t0": 30.02,
   "t1": 30.7,
   "text": "The flower girl"
  },
  {
   "t0": 30.7,
   "t1": 32.34,
   "text": "stops throwing flowers."
  },
  {
   "t0": 32.34,
   "t1": 32.96,
   "text": "The ring bearer"
  },
  {
   "t0": 32.96,
   "t1": 36.02,
   "text": "covers his nose."
  },
  {
   "t0": 36.02,
   "t1": 37.34,
   "text": "What you don't know:"
  },
  {
   "t0": 37.34,
   "t1": 38.2,
   "text": "we wear the ring"
  },
  {
   "t0": 38.2,
   "t1": 39.2,
   "text": "on the fourth finger"
  },
  {
   "t0": 39.2,
   "t1": 40.12,
   "text": "because the ancient"
  },
  {
   "t0": 40.12,
   "t1": 40.98,
   "text": "Romans believed"
  },
  {
   "t0": 40.98,
   "t1": 42.22,
   "text": "a vein ran straight"
  },
  {
   "t0": 42.22,
   "t1": 44.06,
   "text": "from it to the heart."
  },
  {
   "t0": 44.06,
   "t1": 44.86,
   "text": "Right now,"
  },
  {
   "t0": 44.86,
   "t1": 46.2,
   "text": "her heart is fine."
  },
  {
   "t0": 46.2,
   "t1": 47.52,
   "text": "Her nose is not."
  },
  {
   "t0": 47.52,
   "t1": 50.14,
   "text": "\"Do you take this man?\""
  },
  {
   "t0": 50.14,
   "t1": 54.42,
   "text": "Long pause."
  },
  {
   "t0": 54.42,
   "t1": 57.4,
   "text": "Very long pause."
  },
  {
   "t0": 57.4,
   "t1": 58.54,
   "text": "\"I do.\""
  },
  {
   "t0": 58.54,
   "t1": 61.19,
   "text": "From five metres away."
  },
  {
   "t0": 61.19,
   "t1": 64.72,
   "text": "Congratulations."
  }
 ]
}