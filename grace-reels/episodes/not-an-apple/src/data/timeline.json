   "display": "Everyone says Adam and Eve ate an *apple*."
  },
  {
   "id": 1,
   "line": 2,
   "scene": "S1",
   "block": "B02",
   "start": 2.8611111111111107,
   "end": 3.6574074074074074,
   "display": "But here's the thing."
  },
  {
   "id": 2,
   "line": 2,
   "scene": "S1",
   "block": "B02",
   "start": 3.9574074074074073,
   "end": 5.5962962962962965,
   "display": "The Bible never says *apple*."
  },
  {
   "id": 3,
   "line": 2,
   "scene": "S2",
   "block": "B02",
   "start": 5.896296296296296,
   "end": 6.692592592592592,
   "display": "Not once."
  },
  {
   "id": 4,
   "line": 3,
   "scene": "S2",
   "block": "B03",
   "start": 7.192592592592592,
   "end": 8.442592592592591,
   "display": "It just says *fruit*:"
  },
  {
