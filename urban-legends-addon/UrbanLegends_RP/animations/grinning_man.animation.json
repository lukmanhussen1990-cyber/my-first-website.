{
  "format_version": "1.8.0",
  "animations": {
    "animation.horror.grinning_man.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0.0
          ]
        }
      }
    },
    "animation.horror.grinning_man.walk": {
      "loop": true,
      "bones": {
        "leftLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 20.0) * 38.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "rightLeg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 20.0) * 38.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "leftArm": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 20.0) * 20.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "rightArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 20.0) * 20.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "body": {
          "rotation": [
            "10.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.horror.grinning_man.idle": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            0.0,
            0.0,
            "math.sin(query.life_time * 40.0) * 8.0 + (math.mod(query.life_time, 4.5) < 0.15 ? math.sin(query.life_time * 2400.0) * 14.0 : 0.0)"
          ]
        },
        "leftArm": {
          "rotation": [
            "math.sin(query.life_time * 55.0) * 2.5",
            0.0,
            "-2.0 - math.sin(query.life_time * 45.0) * 1.5"
          ]
        },
        "rightArm": {
          "rotation": [
            "-math.sin(query.life_time * 55.0) * 2.5",
            0.0,
            "2.0 + math.sin(query.life_time * 45.0) * 1.5"
          ]
        },
        "leftHand": {
          "rotation": [
            "math.sin(query.life_time * 90.0) * 7.0",
            0.0,
            0.0
          ]
        },
        "rightHand": {
          "rotation": [
            "math.sin(query.life_time * 90.0 + 120.0) * 7.0",
            0.0,
            0.0
          ]
        }
      }
    }
  }
}
