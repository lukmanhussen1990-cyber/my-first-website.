# Third-party style reference: kept local only (not ours to republish in a public repo).
# Rebuild style_refs from the video with the timestamps in reference/style_notes_storybook.md.
grace-reels/reference/*.mp4
grace-reels/reference/frames_storybook/
grace-reels/episodes/*/style_refs/

node_modules/

# regenerable audio stems (rebuild with episodes/<slug>/score.mjs + tools/build_voice.py)
grace-reels/episodes/*/audio/work/
grace-reels/episodes/*/audio/music.wav
grace-reels/episodes/*/audio/sfx.wav
grace-reels/episodes/*/audio/voice.wav
# remotion build cache
grace-reels/.remotion/
