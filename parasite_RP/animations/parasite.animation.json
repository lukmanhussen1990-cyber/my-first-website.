        "tail": {
          "rotation": ["-10", "math.sin(query.modified_distance_moved * 45) * 18", 0]
        },
        "head": {
          "rotation": ["math.sin(query.modified_distance_moved * 90) * 6", 0, 0]
        }
      }
    },

    "animation.pm_parasite.chew": {
      "loop": true,
      "animation_length": 0.8,
      "bones": {
        "jaw": {
          "rotation": ["18 + math.sin(query.life_time * 900) * 18", 0, 0]
        },
        "mandible_left": {
          "rotation": [0, "-18 + math.sin(query.life_time * 700) * 16", 0]
        },
        "mandible_right": {
          "rotation": [0, "18 - math.sin(query.life_time * 700) * 16", 0]
        },
        "eyes": {
          "scale": ["1.0 + math.sin(query.life_time * 260) * 0.15", "1.0 + math.sin(query.life_time * 260) * 0.15", 1.0]
        },
        "head": {
