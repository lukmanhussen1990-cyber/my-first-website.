        "leg_left_back": { "rotation": [0, 0, "-12 + math.sin(query.life_time * 80 + 120) * 4"] },
        "leg_right_front": { "rotation": [0, 0, "12 + math.sin(query.life_time * 80 + 90) * 4"] },
        "leg_right_mid": { "rotation": [0, 0, "10 + math.sin(query.life_time * 80 + 150) * 4"] },
        "leg_right_back": { "rotation": [0, 0, "12 + math.sin(query.life_time * 80 + 210) * 4"] }
      }
    },

    "animation.pm_parasite.walk": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "body": {
          "position": [0, "math.sin(query.modified_distance_moved * 90) * 0.8", 0],
          "rotation": [0, "math.sin(query.modified_distance_moved * 45) * 4", "math.sin(query.modified_distance_moved * 90) * 5"]
        },
        "leg_left_front": {
          "rotation": ["math.sin(query.modified_distance_moved * 90) * 45", 0, "-18 + math.cos(query.modified_distance_moved * 90) * 12"]
        },
        "leg_left_mid": {
          "rotation": ["math.sin(query.modified_distance_moved * 90 + 120) * 45", 0, "-16 + math.cos(query.modified_distance_moved * 90 + 120) * 12"]
        },
        "leg_left_back": {
          "rotation": ["math.sin(query.modified_distance_moved * 90 + 240) * 45", 0, "-18 + math.cos(query.modified_distance_moved * 90 + 240) * 12"]
        },
        "leg_right_front": {
          "rotation": ["math.sin(query.modified_distance_moved * 90 + 180) * 45", 0, "18 - math.cos(query.modified_distance_moved * 90 + 180) * 12"]
        },
        "leg_right_mid": {
          "rotation": ["math.sin(query.modified_distance_moved * 90 + 300) * 45", 0, "16 - math.cos(query.modified_distance_moved * 90 + 300) * 12"]
        },
        "leg_right_back": {
          "rotation": ["math.sin(query.modified_distance_moved * 90 + 60) * 45", 0, "18 - math.cos(query.modified_distance_moved * 90 + 60) * 12"]
