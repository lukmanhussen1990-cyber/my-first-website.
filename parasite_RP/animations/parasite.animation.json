        },
        "tail": {
          "rotation": ["-8 + math.sin(query.life_time * 90) * 6", "math.cos(query.life_time * 70) * 10", 0]
        },
        "stinger": {
          "rotation": ["-25 + math.sin(query.life_time * 130) * 8", 0, 0]
        },
        "spikes": {
          "scale": [1.0, "1.0 + math.sin(query.life_time * 150) * 0.08", 1.0]
        },
        "leg_left_front": { "rotation": [0, 0, "-12 + math.sin(query.life_time * 80) * 4"] },
