{
 "take": "narr_B",
 "duration": 44.38,
 "lines": [
  {
   "i": 1,
   "text": "You just pooped in the forest.",
   "start": 0.285,
   "end": 2.215
  },
  {
   "i": 2,
   "text": "Behind a tree.",
   "start": 2.545,
   "end": 3.51
  },
  {
   "i": 3,
   "text": "No toilet paper.",
   "start": 3.84,
   "end": 4.92
  },
  {
   "i": 4,
   "text": "So you grab a leaf.",
   "start": 5.25,
   "end": 6.39
  },
  {
   "i": 5,
   "text": "It's itchy.",
   "start": 6.72,
   "end": 7.415
  },
  {
   "i": 6,
   "text": "Very itchy.",
   "start": 7.685,
   "end": 8.765
  },
  {
   "i": 7,
   "text": "Then a branch snaps.",
   "start": 9.095,
   "end": 10.285
  },
  {
   "i": 8,
   "text": "You freeze.",
   "start": 10.555,
   "end": 11.28
  },
  {
   "i": 9,
   "text": "Something big is coming.",
   "start": 11.55,
   "end": 12.92
  },
  {
   "i": 10,
   "text": "It's a bear.",
   "start": 13.21,
   "end": 13.985
  },
  {
   "i": 11,
   "text": "A really big bear.",
   "start": 14.255,
   "end": 15.545
  },
  {
   "i": 12,
   "text": "It stops.",
   "start": 15.875,
   "end": 16.545
  },
  {
   "i": 13,
   "text": "It sniffs the air.",
   "start": 16.815,
   "end": 17.825
  },
  {
   "i": 14,
   "text": "Then it walks straight toward you.",
   "start": 18.115,
   "end": 19.95
  },
  {
   "i": 15,
   "text": "You can't run.",
   "start": 20.24,
   "end": 21.05
  },
  {
   "i": 16,
   "text": "You're not done yet.",
   "start": 21.32,
   "end": 22.245
  },
  {
   "i": 17,
   "text": "You hold your breath.",
   "start": 22.52,
   "end": 23.485
  },
  {
   "i": 18,
   "text": "What you don't know:",
   "start": 24.385,
   "end": 25.31
  },
  {
   "i": 19,
   "text": "bears can smell about seven times better than a bloodhound.",
   "start": 25.58,
   "end": 28.605
  },
  {
   "i": 20,
   "text": "It smelled you from miles away.",
   "start": 28.875,
   "end": 30.63
  },
  {
   "i": 21,
   "text": "The bear gets closer.",
   "start": 30.96,
   "end": 32.215
  },
  {
   "i": 22,
   "text": "Closer.",
   "start": 32.54,
   "end": 33.18
  },
  {
   "i": 23,
   "text": "It sniffs once.",
   "start": 33.485,
   "end": 34.395
  },
  {
   "i": 24,
   "text": "Its eyes start watering.",
   "start": 34.68,
   "end": 36.06
  },
  {
   "i": 25,
   "text": "It holds its nose.",
   "start": 36.335,
   "end": 37.395
  },
  {
   "i": 26,
   "text": "And runs away crying.",
   "start": 37.665,
   "end": 39.0
  },
  {
   "i": 27,
   "text": "Even the birds leave.",
   "start": 39.33,
   "end": 40.52
  },
  {
   "i": 28,
   "text": "Enjoy your camping trip.",
   "start": 41.57,
   "end": 42.79
  }
 ]
}