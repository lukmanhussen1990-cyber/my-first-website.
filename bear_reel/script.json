  "lines": [
    {"who": "N", "text": "You just pooped in the forest."},
    {"who": "N", "text": "Behind a tree."},
    {"who": "N", "text": "No toilet paper."},
    {"who": "N", "text": "So you grab a leaf."},
    {"who": "N", "text": "It's itchy."},
    {"who": "N", "text": "Very itchy."},
    {"who": "N", "text": "Then a branch snaps."},
    {"who": "N", "text": "You freeze."},
    {"who": "N", "text": "Something big is coming."},
    {"who": "N", "text": "It's a bear."},
    {"who": "N", "text": "A really big bear."},
    {"who": "N", "text": "It stops."},
    {"who": "N", "text": "It sniffs the air."},
    {"who": "N", "text": "Then it walks straight toward you."},
    {"who": "N", "text": "You can't run."},
    {"who": "N", "text": "You're not done yet."},
    {"who": "N", "text": "You hold your breath."},
    {"who": "N", "text": "What you don't know:", "pause_before": 0.90},
    {"who": "N", "text": "bears can smell about seven times better than a bloodhound."},
    {"who": "N", "text": "It smelled you from miles away."},
    {"who": "N", "text": "The bear gets closer."},
    {"who": "N", "text": "Closer."},
    {"who": "N", "text": "It sniffs once."},
    {"who": "N", "text": "Its eyes start watering."},
    {"who": "N", "text": "It holds its nose."},
    {"who": "N", "text": "And runs away crying."},
    {"who": "N", "text": "Even the birds leave."},
    {"who": "N", "text": "Enjoy your camping trip.", "pause_before": 1.05}
  ]
}
