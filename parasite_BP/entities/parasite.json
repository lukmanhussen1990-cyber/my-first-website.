{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "pm:parasite",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "pm:stage_small": {
        "minecraft:scale": { "value": 0.65 },
        "minecraft:health": { "value": 20, "max": 20 },
        "minecraft:attack": { "damage": 4 },
        "minecraft:movement": { "value": 0.34 },
        "minecraft:collision_box": { "width": 0.7, "height": 0.6 },
        "minecraft:variant": { "value": 0 }
      },
      "pm:stage_large": {
        "minecraft:scale": { "value": 1.0 },
        "minecraft:health": { "value": 44, "max": 44 },
        "minecraft:attack": { "damage": 7 },
        "minecraft:movement": { "value": 0.31 },
        "minecraft:collision_box": { "width": 1.0, "height": 0.9 },
        "minecraft:knockback_resistance": { "value": 0.4 },
        "minecraft:variant": { "value": 1 }
      },
      "pm:stage_apex": {
        "minecraft:scale": { "value": 1.7 },
        "minecraft:health": { "value": 90, "max": 90 },
        "minecraft:attack": { "damage": 12 },
        "minecraft:movement": { "value": 0.29 },
        "minecraft:collision_box": { "width": 1.6, "height": 1.4 },
        "minecraft:knockback_resistance": { "value": 0.8 },
        "minecraft:fire_immune": true,
        "minecraft:variant": { "value": 2 }
      },
      "pm:despawn_now": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["parasite", "monster", "mob"]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? math.random(6,12) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/parasite.json"
      },
      "minecraft:collision_box": {
        "width": 1.0,
        "height": 0.9
      },
      "minecraft:health": {
        "value": 44,
        "max": 44
      },
      "minecraft:attack": {
        "damage": 7
      },
      "minecraft:movement": {
        "value": 0.31
      },
      "minecraft:knockback_resistance": {
        "value": 0.4
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_pass_doors": true,
        "can_open_doors": false,
        "avoid_water": false,
        "avoid_damage_blocks": true
      },
      "minecraft:breathable": {
        "total_supply": 45,
        "suffocate_time": -1,
        "breathes_water": true
      },
      "minecraft:persistent": {},
      "minecraft:nameable": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "parasite"
            },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "reselect_targets": true,
        "within_radius": 26,
        "scan_interval": 8,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "parasite"
                },
                {
                  "any_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_family", "subject": "other", "value": "mob" }
                  ]
                }
              ]
            },
            "max_dist": 26
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "speed_multiplier": 1.3,
        "reach_multiplier": 1.4
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.85,
        "xz_dist": 12,
        "y_dist": 5
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 12,
        "probability": 0.3
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": true
        }
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["pm:stage_small"]
        }
      },
      "pm:grow_large": {
        "remove": {
          "component_groups": ["pm:stage_small"]
        },
        "add": {
          "component_groups": ["pm:stage_large"]
        }
      },
      "pm:grow_apex": {
        "remove": {
          "component_groups": ["pm:stage_small", "pm:stage_large"]
        },
        "add": {
          "component_groups": ["pm:stage_apex"]
        }
      },
      "pm:despawn": {
        "add": {
          "component_groups": ["pm:despawn_now"]
        }
      }
    }
  }
}
