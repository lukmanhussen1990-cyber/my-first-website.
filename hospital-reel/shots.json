 ],
 "captions": [
  {
   "t0": -0.04,
   "t1": 0.56,
   "text": "You came to visit"
  },
  {
   "t0": 0.56,
   "t1": 1.3,
   "text": "your friend."
  },
  {
   "t0": 1.3,
   "t1": 3.26,
   "text": "At a psychiatric hospital."
  },
  {
   "t0": 3.26,
   "t1": 4.52,
   "text": "And you just"
  },
  {
   "t0": 4.52,
   "t1": 5.4,
   "text": "pooped your pants."
  },
  {
   "t0": 5.4,
   "t1": 7.34,
   "text": "In the waiting room."
  },
  {
   "t0": 7.34,
   "t1": 8.98,
   "text": "You try to act normal."
  },
  {
   "t0": 8.98,
   "t1": 9.9,
   "text": "You walk sideways."
  },
  {
   "t0": 9.9,
   "t1": 12.08,
   "text": "Very slowly."
  },
  {
   "t0": 12.08,
   "t1": 13.58,
   "text": "You whisper to yourself:"
  },
  {
   "t0": 13.58,
   "t1": 14.58,
   "text": "\"It's fine."
  },
  {
   "t0": 14.58,
   "t1": 15.76,
   "text": "It's fine.\""
  },
  {
   "t0": 15.76,
   "t1": 16.86,
   "text": "You sweat."
  },
  {
   "t0": 16.86,
   "t1": 18.02,
   "text": "A lot."
  },
  {
   "t0": 18.02,
   "t1": 18.42,
   "text": "A doctor"
  },
  {
   "t0": 18.42,
   "t1": 19.6,
   "text": "is watching you."
  },
  {
   "t0": 19.6,
   "t1": 21.14,
   "text": "He writes something down."
  },
  {
   "t0": 21.14,
   "t1": 22.88,
   "text": "Then he underlines it."
  },
  {
   "t0": 22.88,
   "t1": 24.21,
   "text": "You smile at him."
  },
  {
   "t0": 24.21,
   "t1": 25.77,
   "text": "That makes it worse."
  },
  {
   "t0": 25.77,
   "t1": 27.05,
   "text": "He walks over."
  },
  {
   "t0": 27.05,
   "t1": 27.33,
   "text": "\"How are you"
  },
  {
   "t0": 27.33,
   "t1": 27.87,
   "text": "feeling today?\""
  },
  {
   "t0": 27.87,
   "t1": 29.11,
   "text": "You say:"
  },
  {
   "t0": 29.11,
   "t1": 29.89,
   "text": "\"I just need"
  },
  {
   "t0": 29.89,
   "t1": 30.99,
   "text": "a bathroom.\""
  },
  {
   "t0": 30.99,
   "t1": 31.41,
   "text": "He nods."
  },
  {
   "t0": 31.41,
   "t1": 32.29,
   "text": "And hands you"
  },
  {
   "t0": 32.29,
   "t1": 33.25,
   "text": "a wristband."
  },
  {
   "t0": 33.25,
   "t1": 34.07,
   "text": "It already has"
  },
  {
   "t0": 34.07,
   "t1": 36.72,
   "text": "your name on it."
  },
  {
   "t0": 36.72,
   "t1": 38.08,
   "text": "What you don't know:"
  },
  {
   "t0": 38.08,
   "t1": 39.74,
   "text": "in 1973,"
  },
  {
   "t0": 39.74,
   "t1": 40.6,
   "text": "a scientist sent"
  },
  {
   "t0": 40.6,
   "t1": 41.44,
   "text": "healthy people"
  },
  {
   "t0": 41.44,
   "t1": 43.3,
   "text": "into psychiatric hospitals."
  },
  {
   "t0": 43.3,
   "t1": 44.76,
   "text": "They all got admitted."
  },
  {
   "t0": 44.76,
   "t1": 45.66,
   "text": "Some couldn't get out"
  },
  {
   "t0": 45.66,
   "t1": 47.92,
   "text": "for almost two months."
  },
  {
   "t0": 47.92,
   "t1": 48.84,
   "text": "Week one."
  },
  {
   "t0": 48.84,
   "t1": 49.86,
   "text": "You keep telling them"
  },
  {
   "t0": 49.86,
   "t1": 51.3,
   "text": "you're fine."
  },
  {
   "t0": 51.3,
   "t1": 52.34,
   "text": "Week two."
  },
  {
   "t0": 52.34,
   "t1": 53.36,
   "text": "You still haven't"
  },
  {
   "t0": 53.36,
   "t1": 55.21,
   "text": "changed your pants."
  },
  {
   "t0": 55.21,
   "t1": 56.27,
   "text": "Week three."
  },
  {
   "t0": 56.27,
   "t1": 56.87,
   "text": "Your file"
  },
  {
   "t0": 56.87,
   "t1": 58.17,
   "text": "is very thick."
  },
  {
   "t0": 58.17,
   "t1": 59.55,
   "text": "Every page says"
  },
  {
   "t0": 59.55,
   "t1": 60.97,
   "text": "the same thing:"
  },
  {
   "t0": 60.97,
   "t1": 61.51,
   "text": "\"Patient talks"
  },
  {
   "t0": 61.51,
   "t1": 63.43,
   "text": "about poop a lot.\""
  },
  {
   "t0": 63.43,
   "t1": 63.79,
   "text": "Your friend"
  },
  {
   "t0": 63.79,
   "t1": 65.11,
   "text": "gets discharged."
  },
  {
   "t0": 65.11,
   "t1": 67.31,
   "text": "He waves goodbye."
  },
  {
   "t0": 67.31,
   "t1": 71.16,
   "text": "Enjoy your stay."
  }
 ]
