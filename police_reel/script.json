{
  "title": "Police Station",
  "lines": [
    {"id": 1,  "text": "You walk into the police station."},
    {"id": 2,  "text": "And you poop. Immediately.", "loud_words": ["Immediately."]},
    {"id": 3,  "text": "No warning."},
    {"id": 4,  "text": "You act like nothing happened."},
    {"id": 5,  "text": "Hello, officer. My husband is missing."},
    {"id": 6,  "text": "The officer stops typing."},
    {"id": 7,  "text": "He sniffs."},
    {"id": 8,  "text": "Sir… did you just…"},
    {"id": 9,  "text": "Three days, officer! No calls! No messages!", "loud": true},
    {"id": 10, "text": "The ceiling fan spreads the smell."},
    {"id": 11, "text": "The prisoner in the cell starts praying."},
    {"id": 12, "text": "The police dog faints."},
    {"id": 13, "text": "Describe him."},
    {"id": 14, "text": "Tall. Bald. Big mustache. Sooo handsome."},
    {"id": 15, "text": "Then the toilet door opens."},
    {"id": 16, "text": "A tall, bald man with a big mustache walks out."},
    {"id": 17, "text": "Your husband."},
    {"id": 18, "text": "He sees you."},
    {"id": 19, "text": "Then he smells you."},
    {"id": 20, "text": "Officer… lock me up. Please."},
    {"id": 21, "text": "Nooo, baby! Don't leave me, my sugar muffin! My cuddle bear! My little honey bunny!", "loud": true},
    {"id": 22, "text": "Lock me up. Now.", "loud_words": ["Now."]},
    {"id": 23, "text": "You run to hug him."},
    {"id": 24, "text": "And… it happens again.", "loud_words": ["it", "happens", "again."]},
    {"id": 25, "text": "The officer grabs the keys."},
    {"id": 26, "text": "He locks the cell."},
    {"id": 27, "text": "With himself inside too."}
  ]
}
