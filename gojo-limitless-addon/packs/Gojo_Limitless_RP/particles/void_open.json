          "0.45 * math.clamp(1 - (variable.particle_age / variable.particle_lifetime), 0, 1)",
          "0.45 * math.clamp(1 - (variable.particle_age / variable.particle_lifetime), 0, 1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.75 + variable.particle_random_2 * 0.25",
          "0.65 + variable.particle_random_2 * 0.35",
          1.0,
          "math.clamp(1 - (variable.particle_age / variable.particle_lifetime), 0, 1)"
        ]
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "flash"
        ]
