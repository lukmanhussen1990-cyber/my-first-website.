{
 "duration_voice": 44.51,
 "lines": [
  {
   "i": 1,
   "start": 0.0,
   "end": 1.74,
   "text": "You just pooped in the street."
  },
  {
   "i": 2,
   "start": 2.09,
   "end": 2.94,
   "text": "In Singapore."
  },
  {
   "i": 3,
   "start": 3.34,
   "end": 5.47,
   "text": "One of the cleanest cities in the world."
  },
  {
   "i": 4,
   "start": 5.92,
   "end": 8.12,
   "text": "The street is so clean it shines."
  },
  {
   "i": 5,
   "start": 8.62,
   "end": 9.97,
   "text": "So, everyone notices."
  },
  {
   "i": 6,
   "start": 10.49,
   "end": 11.31,
   "text": "A man stops."
  },
  {
   "i": 7,
   "start": 11.68,
   "end": 13.06,
   "text": "A lady drops her shopping bag."
  },
  {
   "i": 8,
   "start": 13.51,
   "end": 14.37,
   "text": "A kid points."
  },
  {
   "i": 9,
   "start": 14.91,
   "end": 16.29,
   "text": "Then you hear footsteps."
  },
  {
   "i": 10,
   "start": 16.71,
   "end": 17.71,
   "text": "Heavy footsteps."
  },
  {
   "i": 11,
   "start": 18.2,
   "end": 18.85,
   "text": "An officer."
  },
  {
   "i": 12,
   "start": 19.46,
   "end": 20.04,
   "text": "He looks at it."
  },
  {
   "i": 13,
   "start": 20.55,
   "end": 21.22,
   "text": "He looks at you."
  },
  {
   "i": 14,
   "start": 21.77,
   "end": 22.82,
   "text": "He pulls out a notebook."
  },
  {
   "i": 15,
   "start": 23.51,
   "end": 24.38,
   "text": "What you don't know:"
  },
  {
   "i": 16,
   "start": 24.82,
   "end": 28.48,
   "text": "in Singapore, you can get fined just for not flushing a public toilet."
  },
  {
   "i": 17,
   "start": 28.87,
   "end": 30.43,
   "text": "Just for not flushing."
  },
  {
   "i": 18,
   "start": 30.84,
   "end": 32.28,
   "text": "And you didn't even use a toilet."
  },
  {
   "i": 19,
   "start": 32.81,
   "end": 33.62,
   "text": "He starts writing."
  },
  {
   "i": 20,
   "start": 34.04,
   "end": 34.74,
   "text": "And writing."
  },
  {
   "i": 21,
   "start": 35.2,
   "end": 36.37,
   "text": "The receipt starts printing."
  },
  {
   "i": 22,
   "start": 36.8,
   "end": 37.87,
   "text": "It's still printing."
  },
  {
   "i": 23,
   "start": 38.34,
   "end": 39.29,
   "text": "It touches the ground."
  },
  {
   "i": 24,
   "start": 39.7,
   "end": 40.9,
   "text": "It rolls down the street."
  },
  {
   "i": 25,
   "start": 41.27,
   "end": 42.35,
   "text": "It reaches the airport."
  },
  {
   "i": 26,
   "start": 42.98,
   "end": 44.45,
   "text": "Enjoy your trip to Singapore."
  }
 ]
}