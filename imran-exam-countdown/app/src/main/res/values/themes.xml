<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is the same colour as the opening animation's background, so
         cold starts go straight from the launch window into the intro with no flash. -->
    <style name="Base.Theme.ExamCountdown" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorControlActivated">@color/green</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.ExamCountdown.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.ExamCountdown.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.ExamCountdown.Dialog</item>
    </style>

    <!-- Overridden per API level (values-v27, -v29, -v31). -->
    <style name="Theme.ExamCountdown" parent="Base.Theme.ExamCountdown" />

    <style name="Theme.ExamCountdown.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:colorControlActivated">@color/green</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
