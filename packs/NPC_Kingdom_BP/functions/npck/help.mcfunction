tellraw @a[r=48] {"rawtext":[{"text":"\u00a76\u00a7l===== NPC KINGDOM ====="}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e1.\u00a7f Use the \u00a7eKingdom Core\u00a7f spawn egg, or long-press the ground with the Kingdom Core item."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e2.\u00a7f Spawn citizens with the custom \u00a7espawn eggs\u00a7f (Creative) or let them join."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e3.\u00a7f Give an NPC an \u00a7aemerald\u00a7f to \u00a7arecruit\u00a7f it (recruited NPCs can follow you)."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e4.\u00a7f Tap an NPC with the \u00a7eRoyal Command Staff\u00a7f to cycle its order."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e5.\u00a7f Tap an NPC with the \u00a7eRoyal Command Banner\u00a7f to give that order to everyone nearby."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e6.\u00a7f Tap an NPC with an empty hand to talk. Advisors read out the full report."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e7.\u00a7f Tap the \u00a7eKingdom Core\u00a7f with the \u00a7eRoyal Ledger\u00a7f for a report and to collect taxes."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a7e8.\u00a7f Tap the Core with the \u00a7eCelebration Horn\u00a7f to party, or the \u00a7eWar Horn\u00a7f to declare war."}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a77Orders: work, follow, stay, patrol, defend, attack, retreat, gather, build, repair, home, celebrate"}]}
tellraw @a[r=48] {"rawtext":[{"text":"\u00a77Commands: \u00a7f/function npck/found\u00a77, \u00a7f/function npck/give_kit\u00a77, \u00a7f/function npck/kingdom/status"}]}
