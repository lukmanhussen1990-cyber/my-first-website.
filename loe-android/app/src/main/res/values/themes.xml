<resources>
    <style name="Theme.Loe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/loe_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Loe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/loe_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Loe</item>
    </style>
</resources>
