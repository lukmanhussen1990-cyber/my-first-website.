{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "goku:burst_blue",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/goku_particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = variable.size > 0 ? variable.size : 1.0;"
      },
      "minecraft:emitter_lifetime_once": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.35,
          0.78,
          1.0,
          1.0
        ]
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 36
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.2 * variable.size",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "Math.random(3, 10) * variable.size",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.35, 0.8)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.05 + 0.2 * (1 - variable.particle_age / variable.particle_lifetime)",
          "0.05 + 0.2 * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      }
    }
  }
}
