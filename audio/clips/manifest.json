   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s01_p2": {
  "text": "I can see lies. Every single one.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s02_p1": {
  "text": "I've seen them since I was a kid.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s02_p2": {
  "text": "The first one came from my best friend.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s03_p1": {
  "text": "Every morning, it's the same.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s03_p2": {
  "text": "In this class, 6 people are lying right now.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 2 of 2"
 },
 "s04_p1": {
  "text": "Six lies before the first bell.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s04_p2": {
  "text": "Just a normal Monday.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s05_p1": {
  "text": "Perfect grades. Perfect smile.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s05_p2": {
  "text": "And I like the class president. Everyone does.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s06_p1": {
  "text": "She never lies.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s06_p2": {
  "text": "Not once in 3 years. Not one red line.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s07_p1": {
  "text": "Until today.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s07_p2": {
  "text": "I didn't take the exam papers.",
  "voice_id": "TOXPlnYC7z5SQSV2Zgc5",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s08_p1": {
  "text": "The girl who never lies just lied.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s08_p2": {
  "text": "In front of the whole class.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s09_p1": {
  "text": "Then her eyes found mine.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s09_p2": {
  "text": "She knows I saw it.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
   "similarity_boost": 0.75,
   "style": 0.0,
   "use_speaker_boost": true,
   "speed": 0.95
  },
  "source": "ElevenLabs connector, take 1 of 2"
 },
 "s10_p1": {
  "text": "Option A: expose her. Tell the teacher.",
