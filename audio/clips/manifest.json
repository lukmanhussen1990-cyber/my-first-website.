{
 "s01_p1": {
  "text": "When someone lies, I see a red line.",
  "voice_id": "JqrSOsJt1yEJuB9KEB0V",
  "model_id": "eleven_multilingual_v2",
  "voice_settings": {
   "stability": 0.6,
