{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "kj:kaiju",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "kj:state_calm": {
        "minecraft:variant": { "value": 0 },
        "minecraft:movement": { "value": 0.26 }
      },
      "kj:state_charging": {
        "minecraft:variant": { "value": 1 },
        "minecraft:movement": { "value": 0.06 }
      },
      "kj:state_enraged": {
        "minecraft:variant": { "value": 2 },
        "minecraft:movement": { "value": 0.34 },
        "minecraft:attack": { "damage": 60 }
      },
      "kj:despawn_now": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["kaiju", "titan", "monster", "mob"]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 500 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/kaiju.json"
      },

      "minecraft:collision_box": {
        "width": 4.5,
        "height": 12.0
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:health": {
        "value": 1500,
        "max": 1500
      },
      "minecraft:attack": {
        "damage": 40
      },
      "minecraft:movement": {
        "value": 0.26
      },
      "minecraft:knockback_resistance": {
        "value": 1.0,
        "max": 1.0
      },
      "minecraft:fire_immune": true,
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "drowning",
            "deals_damage": false
          },
          {
            "cause": "lightning",
            "deals_damage": false
          },
          {
            "cause": "fire_tick",
            "deals_damage": false
          },
          {
            "cause": "lava",
            "deals_damage": false
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:push_through": {
        "value": 1.0
      },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_pass_doors": true,
        "can_open_doors": false,
        "can_break_doors": true,
        "avoid_water": false,
        "avoid_damage_blocks": false,
        "can_walk": true,
        "can_sink": false
      },
      "minecraft:breathable": {
        "total_supply": 300,
        "suffocate_time": -1,
        "breathes_water": true
      },
      "minecraft:persistent": {},
      "minecraft:nameable": {},

      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "kaiju"
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "must_reach": false,
        "reselect_targets": true,
        "within_radius": 64,
        "scan_interval": 10,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "kaiju"
                },
                {
                  "any_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "is_family", "subject": "other", "value": "mob" }
                  ]
                }
              ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "track_target": true,
        "speed_multiplier": 1.1,
        "reach_multiplier": 3.5,
        "attack_once": false
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0,
        "xz_dist": 24,
        "y_dist": 8,
        "interval": 60
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 32,
        "probability": 0.4
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },

      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 160,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["kj:state_calm"]
        }
      },
      "kj:calm": {
        "remove": {
          "component_groups": ["kj:state_charging", "kj:state_enraged"]
        },
        "add": {
          "component_groups": ["kj:state_calm"]
        }
      },
      "kj:charge": {
        "remove": {
          "component_groups": ["kj:state_calm", "kj:state_enraged"]
        },
        "add": {
          "component_groups": ["kj:state_charging"]
        }
      },
      "kj:enrage": {
        "remove": {
          "component_groups": ["kj:state_calm", "kj:state_charging"]
        },
        "add": {
          "component_groups": ["kj:state_enraged"]
        }
      },
      "kj:despawn": {
        "add": {
          "component_groups": ["kj:despawn_now"]
        }
      }
    }
  }
}
