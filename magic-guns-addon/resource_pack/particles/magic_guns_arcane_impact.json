{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "magic_guns:arcane_impact",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/magic_guns"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.15,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "Math.random(1.5, 4.0)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.35, 0.7)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_1 * 0.1 + 0.08) * (1 - variable.particle_age / variable.particle_lifetime * 0.8)",
          "(variable.particle_random_1 * 0.1 + 0.08) * (1 - variable.particle_age / variable.particle_lifetime * 0.8)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            "(variable.particle_random_2 < 0.333 ? 16 : (variable.particle_random_2 < 0.667 ? 0 : 48))",
            "(variable.particle_random_2 < 0.333 ? 0 : (variable.particle_random_2 < 0.667 ? 0 : 16))"
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-180, 180)"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - variable.particle_age / variable.particle_lifetime"
        ]
      }
    }
  }
}
