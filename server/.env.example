# Copy to .env for local development (`npm run dev` / `npm start` load it automatically).
# On a host (Render, Fly, Railway, Docker…) set these as environment variables instead.

# Required for /v1/assistant. Server-side only — never put this in the app.
ANTHROPIC_API_KEY=

# Port to listen on (most hosts inject PORT themselves).
PORT=8787

# Optional shared secret. When set, the app must send it as the `x-app-token` header
# (EXPO_PUBLIC_AI_APP_TOKEN in the app). A speed bump, not real authentication.
APP_TOKEN=

# Comma-separated browser origins allowed via CORS (e.g. https://lastmile.example.com).
# Empty or * allows any origin. Native apps send no Origin header and are unaffected.
ALLOWED_ORIGINS=

# Per-client token bucket: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (burst = max).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=300000

# Number of reverse proxies in front of the server, used to read the client IP from
# X-Forwarded-For. 0 = use the socket address. Set to 1 behind Render/Fly/Railway.
TRUST_PROXY_HOPS=0

# Upper bound for one assistant call, including SDK retries (ms).
REQUEST_TIMEOUT_MS=60000

# debug | info | warn | error
LOG_LEVEL=info
