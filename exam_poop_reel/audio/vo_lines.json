 "duration": 56.031,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "It's your final exam.",
   "start": 0.08,
   "end": 1.59
  },
  {
   "i": 2,
   "who": "N",
   "text": "You can't hold it anymore.",
   "start": 1.845,
   "end": 3.35
  },
  {
   "i": 3,
   "who": "N",
   "text": "And the teacher said no toilet breaks.",
   "start": 3.69,
   "end": 5.965
  },
  {
   "i": 4,
   "who": "N",
   "text": "So you poop.",
   "start": 6.33,
   "end": 7.23
  },
  {
   "i": 5,
   "who": "N",
   "text": "Right there.",
   "start": 7.46,
   "end": 8.255
  },
  {
   "i": 6,
   "who": "N",
   "text": "At your desk.",
   "start": 8.5,
   "end": 9.505
  },
  {
   "i": 7,
   "who": "N",
   "text": "Into toilet paper.",
   "start": 9.67,
   "end": 11.14
  },
  {
   "i": 8,
   "who": "N",
   "text": "Nobody saw.",
   "start": 11.5,
   "end": 12.435
  },
  {
   "i": 9,
   "who": "N",
   "text": "You think.",
   "start": 12.68,
   "end": 13.415
  },
  {
   "i": 10,
   "who": "N",
   "text": "You wrap it up.",
   "start": 13.795,
   "end": 14.71
  },
  {
   "i": 11,
   "who": "N",
   "text": "Tight.",
   "start": 14.94,
   "end": 15.47
  },
  {
   "i": 12,
   "who": "N",
   "text": "Like a little present.",
   "start": 15.665,
   "end": 16.85
  },
  {
   "i": 13,
   "who": "N",
   "text": "You hide it in your pencil box.",
   "start": 17.11,
   "end": 18.905
  },
  {
   "i": 14,
   "who": "N",
   "text": "Perfect.",
   "start": 19.18,
   "end": 19.86
  },
  {
   "i": 15,
   "who": "N",
   "text": "Then the teacher stands up.",
   "start": 20.26,
   "end": 21.905
  },
  {
   "i": 16,
   "who": "T",
   "text": "Everyone, open your pencil boxes.",
   "start": 22.17,
   "end": 24.4
  },
  {
   "i": 17,
   "who": "T",
   "text": "I'm checking for cheat chits.",
   "start": 24.535,
   "end": 26.075
  },
  {
   "i": 18,
   "who": "N",
   "text": "She walks down the row.",
   "start": 26.425,
   "end": 27.775
  },
  {
   "i": 19,
   "who": "N",
   "text": "Box by box.",
   "start": 28.07,
   "end": 29.425
  },
  {
   "i": 20,
   "who": "N",
   "text": "Getting closer.",
   "start": 29.66,
   "end": 30.66
  },
  {
   "i": 21,
   "who": "N",
   "text": "What you don't know:",
   "start": 31.64,
   "end": 32.76
  },
  {
   "i": 22,
   "who": "N",
   "text": "The first pencils were made in England in the 1500s, after people found a giant lump of graphite in the ground.",
   "start": 32.975,
   "end": 39.635
  },
  {
   "i": 23,
   "who": "N",
   "text": "Your pencil box has a giant lump too.",
   "start": 39.905,
   "end": 42.235
  },
  {
   "i": 24,
   "who": "N",
   "text": "She reaches your desk.",
   "start": 42.635,
   "end": 44.035
  },
  {
   "i": 25,
   "who": "N",
   "text": "She opens it.",
   "start": 44.62,
   "end": 45.57
  },
  {
   "i": 26,
   "who": "N",
   "text": "She stares.",
   "start": 46.225,
   "end": 47.36
  },
  {
   "i": 27,
   "who": "N",
   "text": "She closes it.",
   "start": 47.93,
   "end": 48.87
  },
  {
   "i": 28,
   "who": "N",
   "text": "She walks away.",
   "start": 49.47,
   "end": 50.51
  },
  {
   "i": 29,
   "who": "N",
   "text": "She never checks pencil boxes again.",
   "start": 51.125,
   "end": 53.545
  }
 ]
}