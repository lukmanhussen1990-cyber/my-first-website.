<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is drawn with Compose; the window theme only sets the edge-to-edge frame. -->
    <style name="Theme.RUNOVA" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/runova_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/runova_lime</item>
    </style>

    <!-- System splash (Android 12+ and the compat splash below it), handed over to the animated splash. -->
    <style name="Theme.RUNOVA.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/runova_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.RUNOVA</item>
    </style>
</resources>
