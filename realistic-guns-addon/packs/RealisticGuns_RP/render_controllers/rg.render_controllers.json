{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.rg.gun": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    },
    "controller.render.rg.bullet": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "filter_lighting": true
    }
  }
}
