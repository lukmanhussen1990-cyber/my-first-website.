          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.92,
          0.75,
          "1.0 - variable.particle_age / variable.particle_lifetime * 0.5"
