{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rg:muzzle_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/rg/particle/muzzle_flash"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.dir.x * variable.particle_random_3 * 0.12",
          "variable.dir.y * variable.particle_random_3 * 0.12",
          "variable.dir.z * variable.particle_random_3 * 0.12"
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.035, 0.065)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.flash > 0 ? variable.flash : 0.12) * (0.65 + variable.particle_random_1 * 0.6) * (1.0 - variable.particle_age / variable.particle_lifetime * 0.35)",
          "(variable.flash > 0 ? variable.flash : 0.12) * (0.65 + variable.particle_random_1 * 0.6) * (1.0 - variable.particle_age / variable.particle_lifetime * 0.35)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 32,
          "uv": [
            "math.floor(variable.particle_random_2 * 3.99) * 32",
