{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "rg:awp",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/rg/guns/awp",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.rg.awp"
      },
      "animations": {
        "first_person": "animation.rg.awp.first_person",
        "third_person": "animation.rg.awp.third_person",
        "kick": "animation.rg.awp.kick",
        "reload": "animation.rg.awp.reload",
        "cycle": "animation.rg.awp.cycle",
        "scoped": "animation.rg.awp.scoped"
      },
      "scripts": {
        "pre_animation": [
          "v.kick = math.clamp(q.cooldown_time_remaining('rg_kick') / 0.3, 0.0, 1.0);",
          "v.rl = q.cooldown_time_remaining('rg_reload');",
          "v.rt = v.rl > 0.0 ? 1.0 - math.clamp(v.rl / 3.2, 0.0, 1.0) : 0.0;",
          "v.rw = v.rl > 0.0 ? math.clamp(math.min(v.rt / 0.18, (1.0 - v.rt) / 0.18), 0.0, 1.0) : 0.0;",
          "v.md = v.rl > 0.0 ? (v.rt < 0.5 ? math.clamp((v.rt - 0.12) / 0.22, 0.0, 1.0) : math.clamp(1.0 - (v.rt - 0.55) / 0.22, 0.0, 1.0)) : 0.0;",
          "v.cy = q.cooldown_time_remaining('rg_cycle');",
          "v.cp = v.cy > 0.0 ? 1.0 - math.clamp(v.cy / 1.5, 0.0, 1.0) : 0.0;"
        ],
        "animate": [
          {
            "first_person": "c.is_first_person"
          },
          {
            "third_person": "!c.is_first_person"
          },
          "kick",
          "reload",
          "cycle",
          {
            "scoped": "c.is_first_person && q.is_sneaking && v.rl <= 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.rg.gun"
      ]
    }
  }
}
