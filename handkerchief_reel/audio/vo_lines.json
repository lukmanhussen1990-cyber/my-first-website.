{
 "source": "user upload",
 "duration": 73.7,
 "lines": [
  {
   "i": 1,
   "text": "You're homeless.",
   "start": 0.285,
   "end": 1.2
  },
  {
   "i": 2,
   "text": "You're pooping behind a bush.",
   "start": 1.575,
   "end": 3.13
  },
  {
   "i": 3,
   "text": "And you forgot toilet paper.",
   "start": 3.565,
   "end": 5.51
  },
  {
   "i": 4,
   "text": "Then a black car stops.",
   "start": 6.06,
   "end": 7.955
  },
  {
   "i": 5,
   "text": "A really expensive black car.",
   "start": 8.33,
   "end": 10.495
  },
  {
   "i": 6,
   "text": "The door opens.",
   "start": 11.045,
   "end": 11.93
  },
  {
   "i": 7,
   "text": "A rich lady steps out.",
   "start": 12.34,
   "end": 13.665
  },
  {
   "i": 8,
   "text": "Fur coat.",
   "start": 14.04,
   "end": 14.73
  },
  {
   "i": 9,
   "text": "Diamonds.",
   "start": 15.03,
   "end": 15.76
  },
  {
   "i": 10,
   "text": "Her bodyguard panics.",
   "start": 16.25,
   "end": 17.52
  },
  {
   "i": 11,
   "text": "\"Ma'am... what are you doing?\"",
   "start": 17.895,
   "end": 19.405
  },
  {
   "i": 12,
   "text": "\"Shut up.\"",
   "start": 19.705,
   "end": 20.38
  },
  {
   "i": 13,
   "text": "She walks straight to your bush.",
   "start": 21.33,
   "end": 23.035
  },
  {
   "i": 14,
   "text": "You freeze.",
   "start": 23.555,
   "end": 24.315
  },
  {
   "i": 15,
   "text": "She freezes.",
   "start": 24.755,
   "end": 25.555
  },
  {
   "i": 16,
   "text": "She looks at you.",
   "start": 25.975,
   "end": 26.815
  },
  {
   "i": 17,
   "text": "You look at her.",
   "start": 27.255,
   "end": 28.245
  },
  {
   "i": 18,
   "text": "Then she pulls out her silk handkerchief.",
   "start": 28.745,
   "end": 31.08
  },
  {
   "i": 19,
   "text": "It costs more than your whole life.",
   "start": 31.54,
   "end": 33.655
  },
  {
   "i": 20,
   "text": "She holds it out.",
   "start": 34.11,
   "end": 34.875
  },
  {
   "i": 21,
   "text": "\"You'll need this.\"",
   "start": 35.38,
   "end": 36.225
  },
  {
   "i": 22,
   "text": "What you don't know:",
   "start": 37.275,
   "end": 38.265
  },
  {
   "i": 23,
   "text": "your brain decides if it likes someone's face",
   "start": 38.705,
   "end": 41.105
  },
  {
   "i": 24,
   "text": "in about a tenth of a second.",
   "start": 41.105,
   "end": 42.59
  },
  {
   "i": 25,
   "text": "She decided.",
   "start": 43.055,
   "end": 43.78
  },
  {
   "i": 26,
   "text": "So did you.",
   "start": 44.195,
   "end": 44.79
  },
  {
   "i": 27,
   "text": "First date.",
   "start": 45.59,
   "end": 46.29
  },
  {
   "i": 28,
   "text": "A fancy restaurant.",
   "start": 46.65,
   "end": 47.79
  },
  {
   "i": 29,
   "text": "You eat steak with your hands.",
   "start": 48.235,
   "end": 49.86
  },
  {
   "i": 30,
   "text": "She copies you.",
   "start": 50.24,
   "end": 51.015
  },
  {
   "i": 31,
   "text": "The waiter faints.",
   "start": 51.435,
   "end": 52.49
  },
  {
   "i": 32,
   "text": "Paris.",
   "start": 53.04,
   "end": 53.595
  },
  {
   "i": 33,
   "text": "You poop behind the Eiffel Tower.",
   "start": 53.975,
   "end": 55.7
  },
  {
   "i": 34,
   "text": "For old times' sake.",
   "start": 56.075,
   "end": 56.995
  },
  {
   "i": 35,
   "text": "The wedding.",
   "start": 57.49,
   "end": 58.09
  },
  {
   "i": 36,
   "text": "The bodyguard cries the loudest.",
   "start": 58.49,
   "end": 60.3
  },
  {
   "i": 37,
   "text": "Fifty years later.",
   "start": 61.1,
   "end": 62.285
  },
  {
   "i": 38,
   "text": "Two old people on a porch.",
   "start": 62.715,
   "end": 64.275
  },
  {
   "i": 39,
   "text": "Still holding hands.",
   "start": 64.605,
   "end": 65.79
  },
  {
   "i": 40,
   "text": "She still has the handkerchief.",
   "start": 66.89,
   "end": 68.33
  },
  {
   "i": 41,
   "text": "She never washed it.",
   "start": 69.08,
   "end": 70.17
  },
  {
   "i": 42,
   "text": "That part is weird.",
   "start": 71.02,
   "end": 72.01
  }
 ]
}