    {"who": "N", "text": "You just pooped your pants."},
    {"who": "N", "text": "At Thanksgiving dinner."},
    {"who": "N", "text": "The whole family is here."},
    {"who": "N", "text": "You sit very, very still."},
    {"who": "N", "text": "Nobody notices."},
    {"who": "N", "text": "Then Grandma puts turkey on your plate."},
    {"who": "N", "text": "You take one bite."},
    {"who": "N", "text": "Your stomach rumbles."},
    {"who": "N", "text": "Loud."},
    {"who": "N", "text": "Your uncle looks up."},
    {"who": "U", "text": "Somebody's hungry!", "pause_before": 0.35},
    {"who": "N", "text": "Everyone laughs.", "pause_before": 0.36},
    {"who": "N", "text": "You laugh too."},
    {"who": "N", "text": "Grandma adds mashed potatoes."},
    {"who": "N", "text": "And gravy."},
    {"who": "N", "text": "Every bite, it gets worse."},
    {"who": "N", "text": "What you don't know:", "pause_before": 0.90},
    {"who": "N", "text": "the moment food hits your stomach,"},
    {"who": "N", "text": "your gut gets a signal to make space."},
    {"who": "N", "text": "It's called the gastrocolic reflex."},
    {"who": "N", "text": "Every bite pushes things along."},
    {"who": "N", "text": "You stop eating."},
    {"who": "N", "text": "The whole table goes quiet."},
    {"who": "N", "text": "Grandma stares at you."},
    {"who": "N", "text": "Then she serves you a third plate."},
    {"who": "G", "text": "You look skinny.", "pause_before": 1.05}
  ]
}
