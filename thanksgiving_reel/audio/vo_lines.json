{
 "duration": 49.54,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You just pooped your pants.",
   "start": 0.285,
   "end": 2.185
  },
  {
   "i": 2,
   "who": "N",
   "text": "At Thanksgiving dinner.",
   "start": 2.515,
   "end": 3.81
  },
  {
   "i": 3,
   "who": "N",
   "text": "The whole family is here.",
   "start": 4.14,
   "end": 5.6
  },
  {
   "i": 4,
   "who": "N",
   "text": "You sit very, very still.",
   "start": 5.93,
   "end": 8.12
  },
  {
   "i": 5,
   "who": "N",
   "text": "Nobody notices.",
   "start": 8.45,
   "end": 9.52
  },
  {
   "i": 6,
   "who": "N",
   "text": "Then Grandma puts turkey on your plate.",
   "start": 9.85,
   "end": 12.205
  },
  {
   "i": 7,
   "who": "N",
   "text": "You take one bite.",
   "start": 12.535,
   "end": 13.715
  },
  {
   "i": 8,
   "who": "N",
   "text": "Your stomach rumbles.",
   "start": 14.045,
   "end": 15.34
  },
  {
   "i": 9,
   "who": "N",
   "text": "Loud.",
   "start": 15.64,
   "end": 16.325
  },
  {
   "i": 10,
   "who": "N",
   "text": "Your uncle looks up.",
   "start": 16.655,
   "end": 17.79
  },
  {
   "i": 11,
   "who": "U",
   "text": "Somebody's hungry!",
   "start": 18.14,
   "end": 19.88
  },
  {
   "i": 12,
   "who": "N",
   "text": "Everyone laughs.",
   "start": 20.24,
   "end": 21.24
  },
  {
   "i": 13,
   "who": "N",
   "text": "You laugh too.",
   "start": 21.53,
   "end": 22.45
  },
  {
   "i": 14,
   "who": "N",
   "text": "Grandma adds mashed potatoes.",
   "start": 22.78,
   "end": 24.575
  },
  {
   "i": 15,
   "who": "N",
   "text": "And gravy.",
   "start": 24.865,
   "end": 25.735
  },
  {
   "i": 16,
   "who": "N",
   "text": "Every bite, it gets worse.",
   "start": 26.065,
   "end": 28.095
  },
  {
   "i": 17,
   "who": "N",
   "text": "What you don't know:",
   "start": 28.995,
   "end": 30.055
  },
  {
   "i": 18,
   "who": "N",
   "text": "the moment food hits your stomach,",
   "start": 30.385,
   "end": 32.09
  },
  {
   "i": 19,
   "who": "N",
   "text": "your gut gets a signal to make space.",
   "start": 32.26,
   "end": 34.315
  },
  {
   "i": 20,
   "who": "N",
   "text": "It's called the gastrocolic reflex.",
   "start": 34.645,
   "end": 36.715
  },
  {
   "i": 21,
   "who": "N",
   "text": "Every bite pushes things along.",
   "start": 37.045,
   "end": 38.92
  },
  {
   "i": 22,
   "who": "N",
   "text": "You stop eating.",
   "start": 39.25,
   "end": 40.18
  },
  {
   "i": 23,
   "who": "N",
   "text": "The whole table goes quiet.",
   "start": 40.51,
   "end": 42.205
  },
  {
   "i": 24,
   "who": "N",
   "text": "Grandma stares at you.",
   "start": 42.535,
   "end": 43.835
  },
  {
   "i": 25,
   "who": "N",
   "text": "Then she serves you a third plate.",
   "start": 44.165,
   "end": 46.26
  },
  {
   "i": 26,
   "who": "G",
   "text": "You look skinny.",
   "start": 47.31,
   "end": 48.85
  }
 ]
}