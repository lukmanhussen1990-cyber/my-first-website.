      },
      "animations": {
        "hold_first_person_main_hand": "animation.pas.torchlight.first_person_main_hand",
        "hold_first_person_off_hand": "animation.pas.torchlight.first_person_off_hand",
        "hold_third_person_main_hand": "animation.pas.torchlight.third_person_main_hand",
        "hold_third_person_off_hand": "animation.pas.torchlight.third_person_off_hand"
      },
      "scripts": {
        "initialize": [
          "variable.pas_fp_main_pos_x = -0.72;",
          "variable.pas_fp_main_pos_y = 1.28;",
          "variable.pas_fp_main_pos_z = -3.05;",
          "variable.pas_fp_main_rot_x = 20.35;",
          "variable.pas_fp_main_rot_y = 71.5;",
          "variable.pas_fp_main_rot_z = -108.51;",
          "variable.pas_fp_off_pos_x = -14.5;",
          "variable.pas_fp_off_pos_y = 3.0;",
          "variable.pas_fp_off_pos_z = 15.0;",
          "variable.pas_fp_off_rot_x = 173.05;",
          "variable.pas_fp_off_rot_y = -12.99;",
          "variable.pas_fp_off_rot_z = 159.84;",
          "variable.pas_tp_main_pos_x = 0.0;",
          "variable.pas_tp_main_pos_y = -1.5;",
          "variable.pas_tp_main_pos_z = -1.0;",
          "variable.pas_tp_main_rot_x = 18.0;",
