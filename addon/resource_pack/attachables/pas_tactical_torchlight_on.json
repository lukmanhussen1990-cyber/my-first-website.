          "variable.pas_tp_main_rot_z = 0.0;",
          "variable.pas_tp_off_pos_x = 0.0;",
          "variable.pas_tp_off_pos_y = -1.5;",
          "variable.pas_tp_off_pos_z = -1.0;",
          "variable.pas_tp_off_rot_x = 18.0;",
