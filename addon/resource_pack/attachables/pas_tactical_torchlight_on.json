{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "pas:tactical_torchlight_on",
      "materials": {
        "default": "spider",
        "enchanted": "spider"
      },
      "textures": {
        "default": "textures/entity/pas/tactical_torchlight_on",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.pas.tactical_torchlight"
      },
      "animations": {
        "first_person_anchor_main_hand": "animation.pas.torchlight.first_person_anchor_main_hand",
        "first_person_anchor_off_hand": "animation.pas.torchlight.first_person_anchor_off_hand",
        "hold_first_person": "animation.pas.torchlight.hold_first_person",
        "hold_third_person": "animation.pas.torchlight.hold_third_person"
      },
      "scripts": {
        "initialize": [
          "variable.pas_fp_pos_x = -10.0;",
          "variable.pas_fp_pos_y = -6.65;",
          "variable.pas_fp_pos_z = -18.5;",
          "variable.pas_fp_rot_x = -2.03;",
          "variable.pas_fp_rot_y = -14.65;",
          "variable.pas_fp_rot_z = -25.62;",
          "variable.pas_tp_pos_x = 0.0;",
          "variable.pas_tp_pos_y = -1.5;",
          "variable.pas_tp_pos_z = -1.0;",
          "variable.pas_tp_rot_x = 18.0;",
          "variable.pas_tp_rot_y = 0.0;",
          "variable.pas_tp_rot_z = 0.0;",
          "variable.pas_fp_scale = 1.25;"
        ],
        "animate": [
          {
            "first_person_anchor_main_hand": "c.is_first_person && c.item_slot == 'main_hand'"
          },
          {
            "first_person_anchor_off_hand": "c.is_first_person && c.item_slot != 'main_hand'"
          },
          {
            "hold_first_person": "c.is_first_person"
          },
          {
            "hold_third_person": "!c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
