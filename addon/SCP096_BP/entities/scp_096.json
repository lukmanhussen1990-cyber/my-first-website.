{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "scp:scp_096",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "scp:docile": {
        "minecraft:variant": { "value": 0 },
        "minecraft:movement": { "value": 0.1 },
        "minecraft:attack": { "damage": 0 },
        "minecraft:follow_range": { "value": 16, "max": 16 },
        "minecraft:target_nearby_sensor": {
          "inside_range": 12,
          "outside_range": 16,
          "must_see": true,
          "on_inside_range": {
            "event": "scp:on_triggered",
            "target": "self"
          }
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6,
          "xz_dist": 8,
          "y_dist": 3
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        }
      },

      "scp:enraged": {
        "minecraft:variant": { "value": 1 },
        "minecraft:movement": { "value": 0.42 },
        "minecraft:attack": { "damage": 14 },
        "minecraft:follow_range": { "value": 128, "max": 128 },
        "minecraft:break_door": {},
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "must_reach": false,
          "reselect_targets": true,
          "within_default": 128,
          "persist_time": 120,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 128
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.35,
          "track_target": true,
          "reach_multiplier": 1.6
        },
        "minecraft:behavior.random_stroll": {
          "priority": 7,
          "speed_multiplier": 1.0
        },
        "minecraft:timer": {
          "looping": false,
          "time": [50, 70],
          "time_down_event": { "event": "scp:calm_down" }
        },
        "minecraft:on_target_acquired": {
          "event": "scp:on_triggered",
          "target": "self"
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["scp", "scp_096", "monster", "mob"]
      },
      "minecraft:collision_box": {
        "width": 0.7,
        "height": 2.6
      },
      "minecraft:health": {
        "value": 250,
        "max": 250
      },
      "minecraft:knockback_resistance": {
        "value": 1.0,
        "max": 1.0
      },
      "minecraft:attack": { "damage": 0 },
      "minecraft:movement": { "value": 0.1 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": false,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_break_doors": true,
        "can_walk": true,
        "can_sink": false
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:persistent": {},
      "minecraft:nameable": {},
      "minecraft:ambient_sound_interval": {
        "event_name": "ambient",
        "range": 8,
        "value": 6
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 2
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "fire",
            "deals_damage": false
          },
          {
            "cause": "fire_tick",
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "scp:on_triggered",
              "target": "self"
            },
            "deals_damage": true
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 9,
        "look_distance": 12,
        "probability": 0.05
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["scp:docile"] }
      },
      "scp:on_triggered": {
        "sequence": [
          {
            "remove": { "component_groups": ["scp:docile"] }
          },
          {
            "add": { "component_groups": ["scp:enraged"] }
          }
        ]
      },
      "scp:calm_down": {
        "sequence": [
          {
            "remove": { "component_groups": ["scp:enraged"] }
          },
          {
            "add": { "component_groups": ["scp:docile"] }
          }
        ]
      }
    }
  }
}
