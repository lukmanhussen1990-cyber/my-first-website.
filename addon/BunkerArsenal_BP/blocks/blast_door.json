      },
      {
        "condition": "q.block_state('bunker:half') == 'upper' && !q.block_state('bunker:open')",
        "components": {
          "minecraft:geometry": "geometry.bunker_door_upper",
          "minecraft:collision_box": {
            "origin": [
              -8,
              0,
              -2
            ],
            "size": [
              16,
              16,
              4
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
