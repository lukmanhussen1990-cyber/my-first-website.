{
 "takes": {
  "N": "narr_B",
  "W": "whisper_A"
 },
 "duration": 66.41,
 "lines": [
  {
   "i": 1,
   "who": "N",
   "text": "You're at your girlfriend's house.",
   "start": 0.285,
   "end": 1.895
  },
  {
   "i": 2,
   "who": "N",
   "text": "For the first time.",
   "start": 2.18,
   "end": 3.275
  },
  {
   "i": 3,
   "who": "N",
   "text": "You go to the bathroom.",
   "start": 3.605,
   "end": 4.665
  },
  {
   "i": 4,
   "who": "N",
   "text": "You poop.",
   "start": 4.995,
   "end": 5.555
  },
  {
   "i": 5,
   "who": "N",
   "text": "You flush.",
   "start": 5.875,
   "end": 6.49
  },
  {
   "i": 6,
   "who": "N",
   "text": "Nothing.",
   "start": 7.04,
   "end": 7.555
  },
  {
   "i": 7,
   "who": "N",
   "text": "You flush again.",
   "start": 7.885,
   "end": 8.705
  },
  {
   "i": 8,
   "who": "N",
   "text": "Nothing.",
   "start": 9.305,
   "end": 9.89
  },
  {
   "i": 9,
   "who": "N",
   "text": "The water is rising.",
   "start": 10.21,
   "end": 11.395
  },
  {
   "i": 10,
   "who": "N",
   "text": "You panic.",
   "start": 11.665,
   "end": 12.335
  },
  {
   "i": 11,
   "who": "N",
   "text": "Then you see it.",
   "start": 12.62,
   "end": 13.75
  },
  {
   "i": 12,
   "who": "N",
   "text": "A window.",
   "start": 14.25,
   "end": 14.95
  },
  {
   "i": 13,
   "who": "N",
   "text": "You wrap it in toilet paper.",
   "start": 15.55,
   "end": 16.985
  },
  {
   "i": 14,
   "who": "N",
   "text": "Like a little gift.",
   "start": 17.255,
   "end": 18.135
  },
  {
   "i": 15,
   "who": "N",
   "text": "You even add a bow.",
   "start": 18.415,
   "end": 19.555
  },
  {
   "i": 16,
   "who": "N",
   "text": "You open the window.",
   "start": 19.855,
   "end": 20.96
  },
  {
   "i": 17,
   "who": "N",
   "text": "And you throw it.",
   "start": 21.23,
   "end": 22.07
  },
  {
   "i": 18,
   "who": "N",
   "text": "As far as you can.",
   "start": 22.34,
   "end": 23.605
  },
  {
   "i": 19,
   "who": "N",
   "text": "Then you hear it.",
   "start": 24.155,
   "end": 25.23
  },
  {
   "i": 20,
   "who": "N",
   "text": "Splat.",
   "start": 25.73,
   "end": 26.415
  },
  {
   "i": 21,
   "who": "N",
   "text": "And a scream.",
   "start": 26.865,
   "end": 27.765
  },
  {
   "i": 22,
   "who": "N",
   "text": "You look down.",
   "start": 28.315,
   "end": 29.08
  },
  {
   "i": 23,
   "who": "N",
   "text": "It's her dad.",
   "start": 29.37,
   "end": 30.15
  },
  {
   "i": 24,
   "who": "N",
   "text": "He just got home from work.",
   "start": 30.42,
   "end": 31.83
  },
  {
   "i": 25,
   "who": "N",
   "text": "It's on his shoulder.",
   "start": 32.13,
   "end": 33.08
  },
  {
   "i": 26,
   "who": "N",
   "text": "His best suit.",
   "start": 33.35,
   "end": 34.42
  },
  {
   "i": 27,
   "who": "N",
   "text": "He slowly looks up.",
   "start": 34.82,
   "end": 36.06
  },
  {
   "i": 28,
   "who": "N",
   "text": "You duck.",
   "start": 36.33,
   "end": 36.875
  },
  {
   "i": 29,
   "who": "N",
   "text": "What you don't know:",
   "start": 37.875,
   "end": 38.79
  },
  {
   "i": 30,
   "who": "N",
   "text": "hundreds of years ago in Edinburgh,",
   "start": 39.065,
   "end": 40.85
  },
  {
   "i": 31,
   "who": "N",
   "text": "people threw their poop out the window and shouted \"Gardyloo!\" to warn the people below.",
   "start": 41.12,
   "end": 45.61
  },
  {
   "i": 32,
   "who": "N",
   "text": "You didn't shout anything.",
   "start": 46.21,
   "end": 47.495
  },
  {
   "i": 33,
   "who": "N",
   "text": "Dinner time.",
   "start": 48.295,
   "end": 49.04
  },
  {
   "i": 34,
   "who": "N",
   "text": "Her dad sits across from you.",
   "start": 49.355,
   "end": 50.825
  },
  {
   "i": 35,
   "who": "N",
   "text": "His hair is still wet.",
   "start": 51.095,
   "end": 52.25
  },
  {
   "i": 36,
   "who": "N",
   "text": "He says:",
   "start": 52.55,
   "end": 53.11
  },
  {
   "i": 37,
   "who": "N",
   "text": "\"Strange thing happened today.\"",
   "start": 53.44,
   "end": 54.965
  },
  {
   "i": 38,
   "who": "N",
   "text": "He stares at you.",
   "start": 55.615,
   "end": 56.53
  },
  {
   "i": 39,
   "who": "N",
   "text": "You stare back.",
   "start": 57.03,
   "end": 57.935
  },
  {
   "i": 40,
   "who": "N",
   "text": "And you whisper:",
   "start": 58.835,
   "end": 59.61
  },
  {
   "i": 41,
   "who": "W",
   "text": "\u2026Gardyloo?",
   "start": 61.31,
   "end": 62.12
  }
 ]
}