        "pd_villager_profession": "textures/entity/villager2/professions/farmer",
        "pd_pig": "textures/entity/pig/pig",
        "pd_cow": "textures/entity/cow/cow",
        "pd_sheep": "textures/entity/sheep/sheep",
        "pd_wolf": "textures/entity/wolf/wolf",
        "pd_chicken": "textures/entity/chicken",
        "pd_bee": "textures/entity/bee/bee"
      },
      "geometry": {
        "default": "geometry.humanoid.custom",
        "cape": "geometry.cape",
        "pd_zombie": "geometry.pd.zombie",
        "pd_skeleton": "geometry.pd.skeleton",
        "pd_creeper": "geometry.pd.creeper",
        "pd_creeper_charged": "geometry.pd.creeper_charged",
        "pd_spider": "geometry.pd.spider",
        "pd_enderman": "geometry.pd.enderman",
        "pd_villager": "geometry.pd.villager",
        "pd_pig": "geometry.pd.pig",
        "pd_cow": "geometry.pd.cow",
        "pd_sheep": "geometry.pd.sheep",
        "pd_wolf": "geometry.pd.wolf",
        "pd_chicken": "geometry.pd.chicken",
        "pd_bee": "geometry.pd.bee"
      },
      "scripts": {
        "scale": "(query.variant > 0 && query.variant != 6 && !variable.is_first_person) ? 1.0 : 0.9375",
        "initialize": [
          "variable.is_holding_right = 0.0;",
          "variable.is_blinking = 0.0;",
          "variable.last_blink_time = 0.0;",
          "variable.hand_bob = 0.0;",
          "variable.pd_fuse_time = 0.0;"
        ],
        "pre_animation": [
          "variable.helmet_layer_visible = 1.0;",
          "variable.leg_layer_visible = 1.0;",
          "variable.boot_layer_visible = 1.0;",
          "variable.chest_layer_visible = 1.0;",
          "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
          "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
          "variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
          "variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",
          "variable.pd_tcos0_ender = variable.tcos0 * 0.5;",
          "variable.pd_fuse_time = (query.variant == 3 && query.mark_variant == 1) ? variable.pd_fuse_time + query.delta_time : 0.0;",
          "variable.pd_swell = math.clamp(variable.pd_fuse_time / 1.5, 0.0, 1.0);",
          "variable.pd_wobble = math.sin(variable.pd_swell * 5730.0) * variable.pd_swell * 0.01 + 1.0;",
          "variable.pd_swell_scale1 = (math.pow(variable.pd_swell, 4.0) * 0.4 + 1.0) * variable.pd_wobble;",
          "variable.pd_swell_scale2 = (math.pow(variable.pd_swell, 4.0) * 0.1 + 1.0) / variable.pd_wobble;",
          "variable.pd_flash = math.mod(math.round(variable.pd_swell * 10.0), 2.0);",
          "variable.pd_leg_rot = math.cos(query.modified_distance_moved * 38.17326) * 80.22 * query.modified_move_speed;",
          "variable.pd_wing_flap = query.is_on_ground ? 0.0 : (math.sin(query.life_time * 1800.0) + 1.0) * 40.0;"
        ],
        "animate": [
          "root",
          {
            "pd_hidden": "query.variant > 0"
          },
          {
            "pd_hum_look": "(query.variant == 1 || query.variant == 2 || query.variant == 5)"
          },
          {
            "pd_hum_move": "(query.variant == 1 || query.variant == 2)"
          },
          {
            "pd_ender_move": "(query.variant == 5)"
          },
          {
            "pd_hum_riding_arms": "(query.variant == 1 || query.variant == 2) && query.is_riding"
          },
          {
            "pd_hum_riding_legs": "(query.variant == 1 || query.variant == 2) && query.is_riding"
          },
          {
            "pd_hum_holding": "(query.variant == 1 || query.variant == 2)"
          },
          {
            "pd_hum_attack": "(query.variant == 1 || query.variant == 2 || query.variant == 5) && variable.attack_time >= 0.0"
          },
          {
            "pd_hum_bob": "(query.variant == 1 || query.variant == 2 || query.variant == 5)"
          },
          {
            "pd_zombie_arms": "(query.variant == 1) && !query.is_riding"
          },
          {
            "pd_skeleton_bow": "(query.variant == 2) && query.get_equipped_item_name == 'bow' && variable.item_use_normalized > 0.0 && variable.item_use_normalized < 1.0"
          },
          {
            "pd_ender_base_pose": "(query.variant == 5)"
          },
          {
            "pd_ender_arms_legs": "(query.variant == 5)"
          },
          {
            "pd_look": "(query.variant == 3 || query.variant == 6 || query.variant == 7 || query.variant == 8 || query.variant == 9 || query.variant == 10 || query.variant == 11) && !query.is_sleeping"
          },
          {
            "pd_creeper_legs": "(query.variant == 3)"
          },
          {
            "pd_creeper_swelling": "(query.variant == 3)"
          },
          {
            "pd_spider_legs": "(query.variant == 4)"
          },
          {
            "pd_spider_walk": "(query.variant == 4) ? query.modified_move_speed : 0.0"
          },
          {
            "pd_spider_look": "(query.variant == 4)"
          },
          {
            "pd_villager_general": "(query.variant == 6)"
          },
          {
            "pd_villager_move": "(query.variant == 6) ? query.modified_move_speed : 0.0"
          },
          {
            "pd_quad_setup": "(query.variant == 7 || query.variant == 8)"
          },
          {
            "pd_sheep_setup": "(query.variant == 9)"
          },
          {
            "pd_quad_walk": "(query.variant == 7 || query.variant == 8 || query.variant == 9) ? query.modified_move_speed : 0.0"
          },
          {
            "pd_sheep_grazing": "(query.variant == 9) && query.mark_variant == 2"
          },
          {
            "pd_wolf_setup": "(query.variant == 10)"
          },
          {
            "pd_wolf_tail": "(query.variant == 10)"
          },
          {
            "pd_wolf_tail_wag": "(query.variant == 10)"
          },
          {
            "pd_wolf_legs": "(query.variant == 10)"
          },
          {
            "pd_chicken_general": "(query.variant == 11)"
          },
          {
            "pd_chicken_move": "(query.variant == 11) ? query.modified_move_speed : 0.0"
          },
          {
            "pd_bee_flying": "(query.variant == 12)"
          },
          {
            "pd_bee_bobbing": "(query.variant == 12)"
          },
          {
            "pd_bee_sting": "(query.variant == 12)"
          }
        ]
      },
      "animations": {
        "root": "controller.animation.player.root",
        "base_controller": "controller.animation.player.base",
        "hudplayer": "controller.animation.player.hudplayer",
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "controller.animation.humanoid.look_at_target",
