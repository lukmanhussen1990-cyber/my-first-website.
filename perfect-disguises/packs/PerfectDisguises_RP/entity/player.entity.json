        "pd_bee": "bee"
      },
      "textures": {
        "default": "textures/entity/steve",
        "cape": "textures/entity/cape_invisible",
        "pd_zombie": "textures/entity/zombie/zombie",
        "pd_skeleton": "textures/entity/skeleton/skeleton",
        "pd_creeper": "textures/entity/creeper/creeper",
