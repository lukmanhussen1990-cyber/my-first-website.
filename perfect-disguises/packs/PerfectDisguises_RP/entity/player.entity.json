        "pd_quad_walk": "animation.pd.quadruped.walk",
        "pd_sheep_grazing": "animation.pd.sheep.grazing",
        "pd_wolf_setup": "animation.pd.wolf.setup",
        "pd_wolf_tail": "animation.pd.wolf.tail",
        "pd_wolf_tail_wag": "animation.pd.wolf.tail_wag",
        "pd_wolf_legs": "animation.pd.wolf.leg_default",
        "pd_chicken_general": "animation.pd.chicken.general",
        "pd_chicken_move": "animation.pd.chicken.move",
        "pd_bee_flying": "animation.pd.bee.flying",
        "pd_bee_bobbing": "animation.pd.bee.bobbing",
        "pd_bee_sting": "animation.pd.bee.sting"
      },
      "render_controllers": [
        {
          "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator"
        },
        {
          "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator"
        },
        {
          "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator"
        },
        {
          "controller.render.player.third_person": "(!variable.is_first_person && !variable.map_face_icon && !query.is_spectator) && query.variant == 0"
        },
        {
          "controller.render.player.map": "variable.map_face_icon"
        },
        {
          "controller.render.pd.zombie": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 1"
        },
        {
          "controller.render.pd.skeleton": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 2"
        },
        {
          "controller.render.pd.creeper": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 3"
        },
        {
          "controller.render.pd.creeper_charged": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 3 && query.is_powered"
        },
        {
          "controller.render.pd.spider": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 4"
        },
        {
          "controller.render.pd.enderman": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 5"
        },
        {
          "controller.render.pd.villager_base": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 6"
        },
        {
          "controller.render.pd.villager_clothes": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 6"
        },
        {
          "controller.render.pd.pig": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 7"
        },
        {
          "controller.render.pd.cow": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 8"
        },
        {
          "controller.render.pd.sheep": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 9"
        },
        {
          "controller.render.pd.wolf": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 10"
        },
        {
          "controller.render.pd.chicken": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 11"
        },
        {
          "controller.render.pd.bee": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator && !query.is_invisible && query.variant == 12"
        }
      ],
      "enable_attachables": true
    }
  }
}
