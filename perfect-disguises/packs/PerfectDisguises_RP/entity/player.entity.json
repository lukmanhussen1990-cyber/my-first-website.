        "pd_creeper_legs": "animation.pd.creeper.legs",
        "pd_creeper_swelling": "animation.pd.creeper.swelling",
        "pd_spider_legs": "animation.pd.spider.default_leg_pose",
        "pd_spider_walk": "animation.pd.spider.walk",
        "pd_spider_look": "animation.pd.spider.look_at_target",
        "pd_villager_general": "animation.pd.villager.general",
        "pd_villager_move": "animation.pd.villager.move",
        "pd_quad_setup": "animation.pd.quadruped.setup",
