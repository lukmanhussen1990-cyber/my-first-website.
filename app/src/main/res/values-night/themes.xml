<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AlarmHandler" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/night</item>
    </style>

    <style name="Theme.AlarmHandler.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mascot</item>
        <item name="postSplashScreenTheme">@style/Theme.AlarmHandler</item>
    </style>

    <style name="Theme.AlarmHandler.Ring" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
