<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing from this app is backed up or copied to a new phone. This matters because the API keys are
    encrypted with a key that never leaves this phone's secure hardware: a copied file would be unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
